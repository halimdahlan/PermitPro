@{
	ViewData["Title"] = "Settings / Users / Roles";
	ViewData["SubTitle"] = "Roles that can be given to users";

	var companyId = ViewContext.RouteData.Values["company"] as string;
}

@model UsersViewModel

<div class="d-flex flex-row justify-content-between align-items-center mb-3">
	<div></div>
	<div>
		<a href="/@companyId/users/roles/new" class="btn btn-sm btn-primary"><span class="px-2"><i class="fa-sharp fa-solid fa-plus me-2"></i> New role</span></a>
	</div>
</div>

@if (TempData["SuccessMessage"] != null)
{
	<div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
		<i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}

<div class="card data-grid">
	<div class="card-body">
		<div class="grid-error alert alert-danger d-none" role="alert"></div>
		<table id="tblRoles" class="table table-sm table-hover align-middle w-100">
			<thead>
				<tr>
					<th>Name</th>
					<th>Description</th>
					<th class="text-center">System Role?</th>
					<th class="text-center">No. of Users</th>
					<th>Created When</th>
					<th class="text-center">Action</th>
				</tr>
			</thead>
		</table>
	</div>
	@Html.AntiForgeryToken()
</div>

<div class="d-flex flex-row align-items-center justify-content-between mt-4">
	<div>
		<a asp-controller="users" asp-action="index">
			<span class="mx-3"><i class="fa-solid fa-arrow-left me-3"></i> Back to Users</span>
		</a>
	</div>
</div>


<!-- Modal: Confirm delete -->
<div class="modal fade" id="dlgConfirm" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="dlgConfirmLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header bg-warning">
				<h6 class="modal-title w-100" id="dlgConfirmLabel" style="font-weight:600;">Confirm Delete</h6>
				<a href="#" class="no-loading text-dark" data-bs-dismiss="modal" aria-label="Close">
					<i class="fa-sharp fa-solid fa-xmark fa-xl"></i>
				</a>
			</div>
			<div class="modal-body mb-0">
				You are about to delete this role. Are you sure?
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-sm btn-danger btn-proceed" data-role-id="">Yes, proceed</button>
			</div>
		</div>
	</div>
</div>


@section CustomCss {
	<partial name="_DataGridStyles" />
	<link rel="stylesheet" href="/css/user-roles.css" />
}


@section Scripts {
	<partial name="_DataGridScripts" />

	<script>
		var tbl = null;

		$(document).ready(() => {

			tbl = DataGrid.create('#tblRoles', '/@companyId/users/roles/grid', {
				pageLength: 20,
				language: {
					emptyTable: 'No roles found.',
					zeroRecords: 'No matching roles found.',
				},
				columns: [
					{
						data: 'Name',
						render: (data, type, row) => type === 'display'
							? `<a href="/@companyId/users/roles/${row.Id}/edit">${DataGrid.escapeHtml(data)}</a>`
							: data,
					},
					{ data: 'Description', render: DataGrid.renderText },
					{
						data: 'IsSystemRole',
						className: 'text-center',
						render: (data, type) => type === 'display'
							? (data ? '<i class="fa-sharp fa-solid fa-circle-check fa-lg text-success" title="System role"></i>' : '')
							: (data ? 'System role' : ''),
					},
					{
						data: 'NumOfUsers',
						className: 'dt-center',
						render: (data, type) => type === 'display' ? `<span class="badge bg-secondary">${data}</span>` : data,
					},
					{ data: 'CreatedWhen', className: 'dt-left text-nowrap', render: DataGrid.renderDate },
					DataGrid.htmlColumn('ActionIcons', { className: 'text-center' }),
				],
			});


			@if (User.IsInRole("Super User"))
			{
				@* Super Users: tick rows, then Delete selected (same rules as the row action). *@
				<text>
				DataGrid.bulkDelete(tbl, {
					url: '/@companyId/users/roles/bulk-delete',
					id: (row) => row.Id,
					label: (row) => row.Name,
					one: 'role',
					many: 'roles',
					note: 'Roles are shared by every company. System roles and roles that still have users are skipped.',
				});
				</text>
			}

			$('.btn-proceed').click(() => {
				var roleId = $('.btn-proceed').data('roleId');
				if (!roleId) return;

				$('.loading').show();

				var xhr = $.ajax({
					method: 'DELETE',
					url: '/users/roles/' + roleId,
					headers: { 'RequestVerificationToken': DataGrid.antiForgeryToken() },
				});

				xhr.done((response) => {
					if (response.data === 'OK') {
						$('#dlgConfirm').modal('hide');
						tbl.ajax.reload(null, false);
					}
				});

				xhr.fail((response) => {
					var data = response.responseJSON;
					$('#dlgConfirm').modal('hide');
					alert(data?.errorMessage ?? 'An error occurred. Please try again.');
				});

				xhr.always(() => {
					$('.loading').hide();
				});
			});


			$('#dlgConfirm').on('hidden.bs.modal', () => {
				$('.btn-proceed').data('roleId', '');
			});
		});


		// Called by the delete icon in the server-built ActionIcons column.
		const deleteRole = (id) => {
			$('.btn-proceed').data('roleId', id);
			$('#dlgConfirm').modal('show');
		};
	</script>
}
