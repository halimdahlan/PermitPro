@{
	ViewData["Title"] = "Settings / Users";
	ViewData["SubTitle"] = "People who can sign in, and their roles";
}

@model UsersViewModel

@* Wraps on phones: the buttons first, then the filter. *@
<div class="d-flex flex-wrap align-items-center gap-3 mb-3">
	<div class="flex-grow-1 d-flex align-items-center gap-2 gap-sm-3 order-2 order-sm-1">
		<label for="ddlFilter" class="form-label mb-0 text-nowrap">View by:</label>
		<div class="grid-filter grid-filter-lg">
			<select id="ddlFilter" autocomplete="off">
				<option value="" selected>All users</option>
				<optgroup label="Status">
					<option value="isActive|Active">Active</option>
					<option value="isActive|Inactive">Inactive</option>
				</optgroup>
				<optgroup label="Roles">
					@foreach (var role in Model.Roles?.OrderBy(r => r.Name).ToList() ?? new())
					{
						<option value="roles|@role.Name">@role.Name</option>
					}
				</optgroup>
			</select>
		</div>
	</div>
	<div class="order-1 order-sm-2 ms-auto">
		<a href="/@Model.CompanyId/users/new" class="btn btn-sm btn-primary me-2"><span class="px-2"><i class="fa-sharp fa-solid fa-plus me-2"></i> New user</span></a>
		<a href="/@Model.CompanyId/users/roles" class="btn btn-sm btn-primary"><span class="px-2">User roles</span></a>
	</div>
</div>

@if (TempData["SuccessMessage"] != null)
{
	<div class="alert alert-success alert-dismissible fade show" role="alert mb-3">
		<i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}

<div class="mt-4 card data-grid">
	<div class="card-body">
		<div class="grid-error alert alert-danger d-none" role="alert"></div>
		<table id="tblUsers" class="table table-sm table-hover align-middle w-100">
			<thead>
				<tr>
					<th>Name</th>
					<th>Email</th>
					<th>Designation</th>
					<th>Roles</th>
					<th class="text-center">Is Secured?</th>
					<th class="text-center">Is Active?</th>
					<th>Created When</th>
					<th class="text-center">Action</th>
				</tr>
			</thead>
		</table>
	</div>
	@Html.AntiForgeryToken()
</div>

@section CustomCss {
	<partial name="_DataGridStyles" />
	<link rel="stylesheet" href="~/css/users.css" />
}

@section Scripts {
	<partial name="_DataGridScripts" />

	<script>
		var tbl = null;

		// Column indexes used by the "View by" filter.
		const COL_ROLES = 3;
		const COL_ACTIVE = 5;

		$(document).ready(() => {

			tbl = DataGrid.create('#tblUsers', '/@Model.CompanyId/users/grid', {
				language: {
					emptyTable: 'No users found.',
					zeroRecords: 'No matching users found.',
				},
				columns: [
					{
						data: 'Name',
						render: (data, type, row) => type === 'display'
							? `<a href="/@Model.CompanyId/users/edit/${row.Id}">${DataGrid.escapeHtml(data)}</a>`
							: data,
					},
					{ data: 'Email', render: DataGrid.renderText },
					{ data: 'Designation', render: DataGrid.renderText },
					{ data: 'Roles', render: DataGrid.renderText },
					{
						data: 'IsSecured',
						className: 'text-center',
						searchable: false,
						render: (data, type) => type === 'display'
							? (data ? '<i class="fa-regular fa-user-lock fa-lg" title="Password set"></i>' : '<i class="fa-regular fa-user-unlock fa-lg" title="No password"></i>')
							: (data ? 'Secured' : 'Not secured'),
					},
					{ data: 'IsActive', className: 'text-center', render: DataGrid.renderActive },
					{ data: 'CreatedWhen', className: 'dt-left text-nowrap', render: DataGrid.renderDate },
					DataGrid.htmlColumn('ActionIcons', { className: 'text-center' }),
				],
			});

			@if (User.IsInRole("Super User"))
			{
				@* Super Users: tick rows, then Delete selected (same soft delete as the row action). *@
				<text>
				DataGrid.bulkDelete(tbl, {
					url: '/@Model.CompanyId/users/bulk-delete',
					id: (row) => row.Id,
					label: (row) => row.Name,
					one: 'user',
					many: 'users',
					note: 'A user who has permits, your own account and Super User accounts are skipped.',
				});
				</text>
			}

			new TomSelect('#ddlFilter', {
				allowEmptyOption: true,
				maxOptions: null,
				// Search box inside the dropdown, so the control keeps its height.
				plugins: ['dropdown_input'],
				onChange: onFilterChange,
			});


			$('#btnDeleteItem').click(() => {
				var userId = $('#btnDeleteItem').data('itemId');

				$('#dlgConfirmDeleteItem').modal('hide');
				$('.loading').show();

				var xhr = $.ajax({
					method: 'DELETE',
					url: `/@Model.CompanyId/users/${userId}`,
					headers: { 'RequestVerificationToken': DataGrid.antiForgeryToken() },
				});

				xhr.done((response, status) => {
					if (status == 'success') {
						if (response.data == 'OK') {
							tbl.ajax.reload(null, false);
						}
					}
				});

				xhr.always(() => {
					$('#dlgConfirmDeleteItem').modal('hide');
					$('.loading').hide();
				});
			});

		});


		// Value is "" (all), "isActive|Active", "isActive|Inactive" or "roles|<role name>".
		const onFilterChange = (value) => {
			const [field, search] = (value || '|').split('|');

			// Only one filter at a time: clear the column not being filtered.
			tbl.column(field == 'roles' ? COL_ACTIVE : COL_ROLES).search('');

			if (field == 'roles') {
				DataGrid.filterListItem(tbl, COL_ROLES, search);
			} else {
				DataGrid.filterExact(tbl, COL_ACTIVE, search);
			}
		};


		// Called by the delete icon in the server-built ActionIcons column.
		const deleteUser = (id) => {
			$('#btnDeleteItem').data('itemId', id);
			$('#dlgConfirmDeleteItem').modal('show');
		};

	</script>
}
