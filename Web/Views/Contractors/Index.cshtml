@{
	ViewData["Title"] = "Contractors";
	ViewData["SubTitle"] = "Summary";
}

@model ContractorsViewModel

@* Wraps on phones: the New contractor button first, then the filter. *@
<div class="d-flex flex-wrap align-items-center gap-3 mb-3">
	<div class="flex-grow-1 d-flex align-items-center gap-2 gap-sm-3 order-2 order-sm-1">
		<label for="ddlFilter" class="text-nowrap">View by</label>
		<div class="grid-filter">
			<select id="ddlFilter" autocomplete="off">
				<option value="" selected>All contractors</option>
				<option value="Active">Active</option>
				<option value="Inactive">Inactive</option>
			</select>
		</div>
	</div>
	<div class="order-1 order-sm-2 ms-auto">
		<a href="@Context.CompanyPathBase()/users/new?org=c" class="btn btn-sm btn-primary no-loading"><span class="px-2"><i class="fa-sharp fa-solid fa-plus me-2"></i> New contractor</span></a>
	</div>
</div>

@if (TempData["SuccessMessage"] != null)
{
	<div class="alert alert-success alert-dismissible fade show" role="alert mb-3">
		<i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}

<div class="mt-4 card data-grid">
	<div class="card-body">
		<div class="grid-error alert alert-danger d-none" role="alert"></div>
		<table id="tblContractors" class="table table-sm table-hover align-middle w-100">
			<thead>
				<tr>
					<th>Name</th>
					<th>Email</th>
					<th class="text-center">Is Secured?</th>
					<th class="text-center">Is Active?</th>
					<th>Created When</th>
					<th class="text-center">Action</th>
				</tr>
			</thead>
		</table>
	</div>
	@Html.AntiForgeryToken()
</div>

<div class="d-flex flex-row justify-content-center mt-3 notification">
	<div class="alert alert-dismissible fade" role="alert">
		<span class="alert-message"></span>
		<a href="#" class="no-loading text-dark" data-bs-dismiss="modal" aria-label="Close"><i class="fa-sharp fa-solid fa-xmark fa-xl"></i></a>
	</div>
</div>

@section CustomCss {
	<partial name="_DataGridStyles" />
	<link rel="stylesheet" href="/css/contractors.css" />
}

@section Scripts {
	<partial name="_DataGridScripts" />

	<script>
		var tbl = null;

		// Column index used by the "View by" filter.
		const COL_ACTIVE = 3;

		$(document).ready(() => {

			tbl = DataGrid.create('#tblContractors', '@Context.CompanyPathBase()/contractors/grid', {
				language: {
					emptyTable: 'No contractors found.',
					zeroRecords: 'No matching contractors found.',
				},
				columns: [
					{
						data: 'Name',
						render: (data, type, row) => type === 'display'
							? `<a href="@Context.CompanyPathBase()/users/edit/${row.Id}?org=c">${DataGrid.escapeHtml(data)}</a>`
							: data,
					},
					{ data: 'Email', render: DataGrid.renderText },
					{
						// Server-built lock icon; sort by whether a password is set.
						data: 'IsSecured',
						className: 'text-center',
						searchable: false,
						render: (data, type) => type === 'display' ? data : (data?.includes('fa-user-lock') ? 'Secured' : 'Not secured'),
					},
					{ data: 'IsActive', className: 'text-center', render: DataGrid.renderActive },
					{ data: 'CreatedWhen', className: 'dt-left text-nowrap', render: DataGrid.renderDate },
					DataGrid.htmlColumn('ActionIcons', { className: 'text-center' }),
				],
			});

			new TomSelect('#ddlFilter', {
				allowEmptyOption: true,
				// Search box inside the dropdown, so the control keeps its height.
				plugins: ['dropdown_input'],
				onChange: (value) => DataGrid.filterExact(tbl, COL_ACTIVE, value),
			});


			$('#btnDeleteItem').click(() => {
				var id = $('#btnDeleteItem').data('itemId');

				$('#dlgConfirmDeleteItem').modal('hide');
				$('.loading').show();

				var xhr = $.ajax({
					method: 'DELETE',
					url: `@Context.CompanyPathBase()/users/${id}`,
					headers: { 'RequestVerificationToken': DataGrid.antiForgeryToken() },
				});

				xhr.done((response, status) => {
					if (status == 'success') {
						if (response.data == 'OK') {
							tbl.ajax.reload(null, false);
						}
						$('#dlgConfirmDeleteItem').modal('hide');
					}
				});

				xhr.fail(() => {
					alert('Unable to delete the contractor at the moment. Please try again later.');
				});

				xhr.always(() => {
					$('.loading').hide();
				});
			});

		});


		// Called by the delete icon in the server-built ActionIcons column.
		const deleteUser = (id) => {
			$('#btnDeleteItem').data('itemId', id);
			$('#dlgConfirmDeleteItem').modal('show');
		};

	</script>
}
