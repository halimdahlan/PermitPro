@model List<PermitPro.App.ViewModels.CertificateListViewModel>

@{
	ViewData["Title"] = "Certificates";
	var companyId = ViewContext.RouteData.Values["company"] as string;
	var permitId = ViewData["PermitId"] as Guid?;
}

<div class="page-header d-flex align-items-center justify-content-between mb-3">
	<div class="d-flex align-items-center gap-2">
		<a href="@Context.CompanyPathBase()/permits/edit/form/@permitId" class="btn btn-sm btn-outline-secondary">
			<i class="fa-solid fa-arrow-left me-1"></i> Back to Permit
		</a>
	</div>
	<button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#dlgAddCert">
		<i class="fa-solid fa-plus me-1"></i> Add Certificate
	</button>
</div>

@if (TempData["SuccessMessage"] != null)
{
	<div class="alert alert-success alert-dismissible fade show mb-3">
		<i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}
@if (TempData["ErrorMessage"] != null)
{
	<div class="alert alert-danger alert-dismissible fade show mb-3">
		<i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}

<div class="card shadow-sm border-0">
	<div class="card-body p-0">
		@if (!Model.Any())
		{
			<div class="text-center py-5 text-muted">
				<i class="fa-solid fa-certificate fa-2x mb-3 d-block"></i>
				No certificates attached yet. 
				<a href="#" class="no-loading" data-bs-toggle="modal" data-bs-target="#dlgAddCert">Add one.</a>
			</div>
		}
		else
		{
			<table class="table table-hover mb-0 align-middle">
				<thead class="table-light">
					<tr>
						<th style="padding-left:1.25rem;">Name</th>
						<th>Description</th>
						<th class="text-center">Template</th>
						<th class="text-center">Data</th>
						<th class="text-end" style="padding-right:1.25rem;">Actions</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var c in Model)
					{
						<tr>
							<td style="padding-left:1.25rem;" class="fw-500">@c.Name</td>
							<td><small class="text-muted">@c.Description</small></td>
							<td class="text-center">
								@if (c.HasTemplate)
								{
									<span class="badge bg-success-soft text-success"><i class="fa-solid fa-check"></i></span>
								}
								else
								{
									<span class="badge bg-secondary-soft text-secondary">None</span>
								}
							</td>
							<td class="text-center">
								@if (c.HasData)
								{
									<span class="badge bg-info-soft text-info"><i class="fa-solid fa-check"></i></span>
								}
								else
								{
									<span class="text-muted">—</span>
								}
							</td>
							<td class="text-end" style="padding-right:1.25rem;">
								<a href="@Context.CompanyPathBase()/permits/@permitId/certificates/@c.Id" class="btn btn-sm btn-outline-primary me-1"
									title="Open form">
									<i class="fa-solid fa-pen-to-square"></i>
								</a>
								<form method="post" action="@Context.CompanyPathBase()/permits/@permitId/certificates/@c.Id/delete" class="d-inline"
										onsubmit="return confirm('Delete certificate \'@c.Name\'?')">
									@Html.AntiForgeryToken()
									<button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
										<i class="fa-solid fa-trash"></i>
									</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
</div>

@* ── Add certificate modal ────────────────────────────────────────────────── *@
<div class="modal fade" id="dlgAddCert" tabindex="-1" aria-labelledby="dlgAddCertTitle" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header bg-dark text-white">
				<h6 class="modal-title fw-semibold" id="dlgAddCertTitle">Add Certificate</h6>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<form method="post" action="@Context.CompanyPathBase()/permits/@permitId/certificates">
				@Html.AntiForgeryToken()
				<div class="modal-body">
					<div class="mb-3">
						<label class="form-label">Name <span class="text-danger">*</span></label>
						<input type="text" name="name" class="form-control" maxlength="200"
								 placeholder="e.g. Hot Work Certificate" required />
					</div>
					<div class="mb-3">
						<label class="form-label">Description</label>
						<input type="text" name="description" class="form-control" maxlength="500" />
					</div>
				</div>
				<div class="modal-footer bg-light">
					<button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
					<button type="submit" class="btn btn-sm btn-primary">
						<i class="fa-solid fa-plus me-1"></i> Add
					</button>
				</div>
			</form>
		</div>
	</div>
</div>
