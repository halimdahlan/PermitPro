@using System.Text.Json
@model PermitPro.App.ViewModels.CertificateFormViewModel

@{
	ViewData["Title"] = Model.Name;
	var companyId = ViewContext.RouteData.Values["company"] as string;

	var savedFields = "{}";
	if (!string.IsNullOrWhiteSpace(Model.CertificateDataJson))
	{
		try
		{
			using var doc = JsonDocument.Parse(Model.CertificateDataJson);
			if (doc.RootElement.TryGetProperty("fields", out var f))
				savedFields = f.GetRawText();
		}
		catch { }
	}
}

<div class="d-flex align-items-center gap-2 mb-3">
	<a href="@Context.CompanyPathBase()/permits/@Model.PermitId/certificates" class="btn btn-sm btn-outline-secondary">
		<i class="fa-solid fa-arrow-left me-1"></i> Back
	</a>
	<h6 class="mb-0 ms-1"><i class="fa-solid fa-certificate me-2 text-primary"></i> @Model.Name</h6>
</div>

@if (!Model.FormTemplateId.HasValue)
{
	@* ── No template assigned — let user pick one ─────────────────────────── *@
	<div class="card shadow-sm border-0 mb-3">
		<div class="card-header bg-light fw-semibold fs-6">
			<i class="fa-solid fa-table-columns me-2"></i> Assign Form Template
		</div>
		<div class="card-body">
			@if (!Model.AvailableTemplates.Any())
			{
				<div class="alert alert-warning mb-0">
					No certificate form templates found. Create one at
					<a href="@Context.CompanyPathBase()/certificatetemplates">Certificate Templates</a>.
				</div>
			}
			else
			{
				<form method="post" action="@Context.CompanyPathBase()/permits/@Model.PermitId/certificates/@Model.CertificateId/template"
						class="d-flex gap-2 align-items-end">
					@Html.AntiForgeryToken()
					<div class="flex-grow-1">
						<label class="form-label small">Select a template to use for this certificate</label>
						<select name="templateId" class="form-select form-select-sm" required>
							<option value="">— select template —</option>
							@foreach (var t in Model.AvailableTemplates)
							{
								<option value="@t.Id">
									@t.Name
								</option>
							}
						</select>
					</div>
					<button type="submit" class="btn btn-sm btn-primary">
						<i class="fa-solid fa-link me-1"></i> Assign
					</button>
				</form>
			}
		</div>
	</div>
}
else
{
	@* ── Template assigned — render the form ─────────────────────────────── *@
	<div class="card shadow-sm border-0 mb-3">
		<div class="card-header bg-light fw-semibold fs-6 d-flex align-items-center justify-content-between">
			<span><i class="fa-solid fa-list-check me-2"></i> Certificate Form</span>
			<form method="post" action="@Context.CompanyPathBase()/permits/@Model.PermitId/certificates/@Model.CertificateId/template"
					class="d-inline">
				@Html.AntiForgeryToken()
				<select name="templateId" class="form-select form-select-sm d-inline-block" style="width:auto;"
						  onchange="this.form.submit()">
					@foreach (var t in Model.AvailableTemplates)
					{
						<option value="@t.Id" selected="@(t.Id == Model.FormTemplateId)">@t.Name</option>
					}
				</select>
			</form>
		</div>
		<div class="card-body">
			<div id="certFormCanvas"></div>
			<div class="d-flex align-items-center justify-content-end gap-2 mt-3">
				<a href="@Context.CompanyPathBase()/permits/@Model.PermitId/certificates" class="btn btn-sm btn-outline-secondary">
					Cancel
				</a>
				<button type="button" class="btn btn-sm btn-primary" onclick="saveCertificate()">
					<i class="fa-solid fa-floppy-disk me-1"></i> Save
				</button>
			</div>
		</div>
	</div>
}

@section CustomCss {
	<partial name="_FlatpickrStyles" />
	<style>
		.pf-row {
			display: grid;
			gap: 1rem;
			margin-bottom: 1.25rem;
		}

		.pf-row.cols-1 {
			grid-template-columns: 1fr;
		}

		.pf-row.cols-2 {
			grid-template-columns: 1fr 1fr;
		}

		.pf-row.cols-3 {
			grid-template-columns: 1fr 1fr 1fr;
		}

		.pf-field label {
			font-size: .85rem;
			font-weight: 600;
			color: var(--label);
			display: block;
			margin-bottom: .3rem;
		}

		.pf-empty-slot {
			min-height: 52px;
			border: 1px dashed var(--border);
			border-radius: .4rem;
			background: var(--surface-2);
		}
	</style>
}

@section Scripts {
	<partial name="_FlatpickrScripts" />
	<script>
		const CERT_LAYOUT = @Html.Raw(Model.LayoutJson);
		const CERT_FIELDS = @Html.Raw(savedFields);
		const CERT_ID = '@Model.CertificateId';
		const SAVE_URL = '@Context.CompanyPathBase()/permits/@Model.PermitId/certificates/@Model.CertificateId/save';
	</script>
	<script>
		document.addEventListener('DOMContentLoaded', () => {
		renderCertForm(CERT_LAYOUT, CERT_FIELDS);
		});

		function renderCertForm(layout, savedFields) {
		const canvas = document.getElementById('certFormCanvas');
		if (!canvas) return;
		canvas.innerHTML = '';

		if (!layout.rows || !layout.rows.length) {
		canvas.innerHTML = '<div class="alert alert-warning">No form layout defined for this template.</div>';
		return;
		}

		layout.rows.forEach(row => {
		const rowEl = document.createElement('div');
		rowEl.className = `pf-row cols-${row.columnCount}`;
		row.columns.forEach(col => {
		const cell = document.createElement('div');
		cell.className = 'pf-field';
		cell.innerHTML = col.controlId ? buildCertField(col, savedFields) : '<div class="pf-empty-slot"></div>';
		rowEl.appendChild(cell);
		});
		canvas.appendChild(rowEl);
		});

		// Init Flatpickr on date fields
		canvas.querySelectorAll('.cert-flatpickr').forEach(el => {
		flatpickr(el, { enableTime: true, dateFormat: 'Y-m-d H:i', altInput: true, altFormat: 'd M Y  H:i', time_24hr: true, defaultHour: 0, defaultMinute: 0 });
		});
		}

		function buildCertField(col, savedFields) {
		const ctrl = col.control;
		if (!ctrl) return '<div class="pf-empty-slot"></div>';
		const label = col.labelOverride || ctrl.label;
		const req = col.isRequiredOverride ?? ctrl.isRequired;
		const val = savedFields[col.id];
		const reqMark = req ? ' <span class="text-danger">*</span>' : '';
		const helpEl = ctrl.helpText ? `<div class="form-text text-muted">${esc(ctrl.helpText)}</div>` : '';
		const reqAttr = req ? 'data-required="true"' : '';

		switch (ctrl.controlType) {
		case 0: return `<label class="form-label">${esc(label)}${reqMark}</label>
		<input type="text" id="cf_${col.id}" data-col="${col.id}" class="form-control form-control-sm cert-input"
		value="${esc(val ?? '')}" placeholder="${esc(ctrl.placeholder ?? '')}" ${reqAttr} />${helpEl}`;
		case 1: return `<label class="form-label">${esc(label)}${reqMark}</label>
		<textarea id="cf_${col.id}" data-col="${col.id}" class="form-control form-control-sm cert-input"
		rows="3" ${reqAttr}>${esc(val ?? '')}</textarea>${helpEl}`;
		case 2: {
		const chk = val === true || val === 'true' ? 'checked' : '';
		return `<div class="form-check mt-2">
		<input class="form-check-input cert-input" type="checkbox" id="cf_${col.id}" data-col="${col.id}" ${chk} />
		<label class="form-check-label" for="cf_${col.id}">${esc(label)}${reqMark}</label>
		</div>${helpEl}`;
		}
		case 3: {
		let opts = []; try { opts = JSON.parse(ctrl.optionsJson || '[]'); } catch { }
		const savedArr = Array.isArray(val) ? val : (val ? [val] : []);
		const checks = opts.map((o, i) => `<div class="form-check form-check-inline">
		<input class="form-check-input cert-multi" type="checkbox" id="cf_${col.id}_${i}"
		data-col="${col.id}" value="${esc(o.value)}" ${savedArr.includes(o.value) ? 'checked' : ''} />
		<label class="form-check-label" for="cf_${col.id}_${i}">${esc(o.label)}</label>
		</div>`).join('');
		return `<label class="form-label d-block">${esc(label)}${reqMark}</label>${checks}${helpEl}`;
		}
		case 4: {
		let opts = []; try { opts = JSON.parse(ctrl.optionsJson || '[]'); } catch { }
		const options = `<option value="">— select —</option>` +
		opts.map(o => `<option value="${esc(o.value)}" ${val === o.value ? 'selected' : ''}>${esc(o.label)}</option>`).join('');
		return `<label class="form-label">${esc(label)}${reqMark}</label>
		<select id="cf_${col.id}" data-col="${col.id}" class="form-select form-select-sm cert-input" ${reqAttr}>${options}</select>${helpEl}`;
		}
		case 5: return `<label class="form-label">${esc(label)}${reqMark}</label>
		<input type="text" id="cf_${col.id}" data-col="${col.id}"
		class="form-control form-control-sm cert-input cert-flatpickr"
		value="${esc(val ? String(val).substring(0, 16) : '')}" placeholder="dd Mon yyyy  HH:mm" ${reqAttr} />${helpEl}`;
		case 7: {
			let hlvl = 'h3'; try { hlvl = JSON.parse(ctrl.optionsJson || '{}').headingLevel || 'h3'; } catch {}
			return `<div style="padding:.25rem 0;"><${hlvl}>${esc(label)}</${hlvl}><hr style="margin:.35rem 0;" /></div>`;
		}
		default: return `<label class="form-label">${esc(label)}</label>
		<input type="text" data-col="${col.id}" class="form-control form-control-sm cert-input" value="${esc(val ?? '')}" />`;
		}
		}

		function collectCertFields() {
		const fields = {};
		document.querySelectorAll('.cert-input').forEach(el => {
		const col = el.dataset.col; if (!col) return;
		fields[col] = el.type === 'checkbox' ? el.checked : el.value;
		});
		const multi = {};
		document.querySelectorAll('.cert-multi').forEach(el => {
		const col = el.dataset.col; if (!multi[col]) multi[col] = [];
		if (el.checked) multi[col].push(el.value);
		});
		return { ...fields, ...multi };
		}

		async function saveCertificate() {
		const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
		const btn = document.querySelector('button[onclick="saveCertificate()"]');
		const origLabel = btn.innerHTML;
		btn.disabled = true;
		btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving…';

		try {
		const res = await fetch(SAVE_URL, {
		method: 'POST',
		headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
		body: JSON.stringify({ dataJson: JSON.stringify({ fields: collectCertFields() }) }),
		});
		if (!res.ok) throw new Error(await res.text());
		showCertToast('Certificate saved.', 'success');
		} catch (err) {
		showCertToast('Save failed: ' + err.message, 'danger');
		} finally {
		btn.disabled = false; btn.innerHTML = origLabel;
		}
		}

		function showCertToast(msg, type) {
		const el = document.createElement('div');
		el.className = `alert alert-${type} alert-dismissible fade show position-fixed bottom-0 end-0 m-3`;
		el.style.zIndex = '9999';
		el.innerHTML = `${esc(msg)}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
		document.body.appendChild(el);
		setTimeout(() => el.remove(), 4000);
		}

		function esc(s) {
		if (s == null) return '';
		return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
		}
	</script>
}
