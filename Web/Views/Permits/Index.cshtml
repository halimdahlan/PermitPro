@{
	ViewData["Title"] = "Permits";
	ViewData["SubTitle"] = "Summary";

	var companyId = ViewContext.RouteData.Values["company"] as string;
}

@model PermitViewModel

@* Wraps on phones: the New permit button first, then the filter and its links. *@
<div class="d-flex flex-wrap align-items-center gap-3">
	<div class="flex-grow-1 d-flex align-items-center gap-2 gap-sm-3 order-2 order-sm-1">
		<label for="ddlFilter" class="text-nowrap">Filter by</label>
		<div class="grid-filter">
			<select id="ddlFilter" asp-items="Model.StatusOptions" autocomplete="off"></select>
		</div>
		<div class="d-flex gap-1">
			<button type="button" class="btn btn-sm btn-outline-secondary grid-icon-btn lnk-clear-filter" title="Clear filter" aria-label="Clear filter"><i class="fa-solid fa-filter-circle-xmark"></i></button>
			<button type="button" class="btn btn-sm btn-outline-secondary grid-icon-btn lnk-reload-grid" title="Reload grid" aria-label="Reload grid"><i class="fa-solid fa-arrows-rotate"></i></button>
		</div>
		@if (User.IsInRole("Super User"))
		{
			@* Archived permits (Auto-archive rule) are hidden from everyone else. *@
			<div class="form-check form-switch mb-0 ms-1 text-nowrap">
				<input class="form-check-input" type="checkbox" role="switch" id="chkShowArchived" />
				<label class="form-check-label" for="chkShowArchived">Show archived</label>
			</div>
		}
	</div>
	<div class="order-1 order-sm-2 ms-auto">
		@if (Model.PermitTemplateMissing)
		{
			<button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#dlgNoPermitTemplate"><span class="px-2"><i class="fa-sharp fa-solid fa-plus me-2"></i> New permit</span></button>
		}
		else
		{
			<a asp-controller="permits" asp-action="new" class="btn btn-sm btn-primary"><span class="px-2"><i class="fa-sharp fa-solid fa-plus me-2"></i> New permit</span></a>
		}
	</div>
</div>

<div class="mt-4 mt-sm-5 card data-grid">
	<div class="card-body">
		<div class="grid-error alert alert-danger d-none" role="alert"></div>
		<table id="tblPermits" class="table table-sm table-hover align-middle w-100">
			<thead>
				<tr>
					<th class="hdr-permit-no">Permit No.</th>
					<th class="hdr-description">Description</th>
					<th class="hdr-location">Location</th>
					<th class="hdr-start-date">Start Date</th>
					<th class="hdr-end-date">End Date</th>
					<th class="hdr-certificates text-center">Certificates</th>
					<th class="hdr-status text-center">Status</th>
					<th class="hdr-submitted-by">Submitted By</th>
					<th class="hdr-action text-center">Action</th>
				</tr>
			</thead>
		</table>
	</div>
	<div>
		@Html.AntiForgeryToken()
	</div>
</div>

<!-- Modal -->
<div class="modal fade" id="dlgPermitConfirmDelete" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-warning">
			<h6 class="modal-title w-100" id="dlgPermitConfirmDeleteLabel" style="font-weight:600;">Confirm Delete <span class="mb-2 text-danger" id="permitNumber"></span></h6>
			<button type="button" class="btn btn-clear" data-bs-dismiss="modal" aria-label="Close">
				<i class="fa-regular fa-close"></i>
			</button>
      </div>
      <div class="modal-body mb-0">
			You are about to delete this permit. Are you sure?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">No</button>
        <button id="btnDelete" type="button" class="btn btn-sm btn-outline-danger" data-permit-id="" data-bs-dismiss="modal">Yes, please proceed</button>
      </div>
    </div>
  </div>
</div>

@section CustomCss {
	<partial name="_DataGridStyles" />
	<link rel="stylesheet" href="~/css/permits.css" />
	<link rel="stylesheet" href="~/css/permits-index.css" asp-append-version="true" />
}

@if (Model.PermitTemplateMissing || Model.ShowPermitTemplateMissing)
{
	var canCreateTemplate = User.IsInRole("Super User");

	<div class="modal fade" id="dlgNoPermitTemplate" tabindex="-1" aria-labelledby="dlgNoPermitTemplateLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-header bg-warning">
					<h6 class="modal-title w-100" id="dlgNoPermitTemplateLabel" style="font-weight:600;">Permit form not set up</h6>
					<button type="button" class="btn btn-sm btn-clear" data-bs-dismiss="modal" aria-label="Close">
						<i class="fa-regular fa-close fa-xl"></i>
					</button>
				</div>
				<div class="modal-body">
					<p class="mb-2">New permits now use the new permit form, but no permit form template has been created yet.</p>
					@if (canCreateTemplate)
					{
						<p class="mb-0">Create one under <strong>Admin → Templates → Permit/Certificate</strong>, then try again.</p>
					}
					else
					{
						<p class="mb-0">Please ask your system administrator to set one up.</p>
					}
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
					@if (canCreateTemplate)
					{
						<a href="/@companyId/formtemplates/new" class="btn btn-sm btn-primary"><i class="fa-solid fa-plus me-1"></i> Create permit template</a>
					}
				</div>
			</div>
		</div>
	</div>
}

@section Scripts {
	<partial name="_DataGridScripts" />

	@if (Model.ShowPermitTemplateMissing)
	{
		@* Sent here from the new-permit URL because there is no permit template. *@
		<script>
			document.addEventListener('DOMContentLoaded', () => bootstrap.Modal.getOrCreateInstance(document.getElementById('dlgNoPermitTemplate')).show());
		</script>
	}

	<script>
		var companyId = '@companyId';
		var gridFilter = '@Model.GridFilter';
		var gridFilterField = '@Model.GridFilterField';
		var tbl = null;
		var ddlFilter = null;

		// Column indexes used by the filters below.
		const COL_LOCATION = 2;
		const COL_STATUS = 6;

		$(document).ready(() => {

			tbl = DataGrid.create('#tblPermits', '@Url.Action("GetGridData", "Permits", new { company = Model.CompanyId })', {
				language: {
					emptyTable: 'No permits found.',
					zeroRecords: 'No matching permits found.',
				},
				columns: [
					{
						data: 'PermitNumber',
						className: 'text-nowrap',
						render: (data, type, row) => type === 'display'
							? `<a href="/${companyId}/permits/edit/${row.Id}">${DataGrid.escapeHtml(data)}</a>`
							: data,
					},
					{ data: 'Description', className: 'col-description', render: DataGrid.renderText },
					{ data: 'Location', render: DataGrid.renderText },
					{ data: 'StartDate', className: 'dt-left text-nowrap', render: DataGrid.renderDate },
					{ data: 'EndDate', className: 'dt-left text-nowrap', render: DataGrid.renderDate },
					DataGrid.htmlColumn('Certificates', { className: 'text-center' }),
					{
						// Search and sort on the plain status; show the badge.
						data: 'Status',
						className: 'text-center',
						render: (data, type, row) => type === 'display'
							? row.StatusBadge + (row.IsArchived ? '<div><span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle mt-1" title="Archived">ARCHIVED</span></div>' : '')
							: data,
					},
					{
						data: 'SubmittedBy',
						render: (data, type, row) => type === 'display'
							? `<div>${DataGrid.escapeHtml(data)}</div><div class="text-secondary submitted-on">on ${moment(row.DateSubmitted).format('DD MMM, YYYY')}</div>`
							: data,
					},
					DataGrid.htmlColumn(null, {
						className: 'text-center text-nowrap',
						render: (data, type, row) =>
							`<a href="/${companyId}/permits/edit/${row.Id}" class="no-loading text-secondary me-3" title="Edit"><i class="fa-solid fa-money-check-pen fa-lg"></i></a>` +
							`<a href="javascript:;" class="no-loading text-danger btn-delete-permit" data-id="${row.Id}" data-permit-number="${DataGrid.escapeHtml(row.PermitNumber)}" title="Delete"><i class="fa-solid fa-trash-xmark fa-lg"></i></a>`,
					}),
				],
			});

			ddlFilter = new TomSelect('#ddlFilter', {
				allowEmptyOption: true,
				maxOptions: null,
				// Search box inside the dropdown, so the control keeps its height.
				plugins: ['dropdown_input'],
				onChange: (value) => DataGrid.filterExact(tbl, COL_STATUS, value),
			});

			// Optional filter from the query string: ?filter=APPROVED&field=Status (or field=Location).
			if (gridFilter != '' && gridFilterField != '') {
				if (gridFilterField == 'Status') {
					ddlFilter.setValue(gridFilter);
				} else {
					DataGrid.filterExact(tbl, COL_LOCATION, gridFilter);
				}
			}

			$('.lnk-clear-filter').click(() => {
				ddlFilter.setValue('');
				tbl.search('');
				DataGrid.filterExact(tbl, COL_LOCATION, '');
			});

			$('.lnk-reload-grid').click(() => {
				tbl.ajax.reload(null, false);
			});

			const gridUrl = tbl.ajax.url();
			$('#chkShowArchived').on('change', (e) => {
				tbl.ajax.url(e.target.checked ? gridUrl + '?archived=true' : gridUrl).load();
			});

			$('#tblPermits').on('click', '.btn-delete-permit', (e) => {
				const link = $(e.currentTarget);
				confirmDelete(link.data('id'), link.data('permitNumber'));
			});

			$('#dlgPermitConfirmDelete').on('hide.bs.modal', event => {
				$('#permitNumber').text('');
			});

			$('#btnDelete').click(() => {
				const id = $('#btnDelete').data('permitId');
				$('#dlgPermitConfirmDelete').modal('hide');

				deletePermit(id);
			});

		});


		const confirmDelete = (id, permitNumber) => {
			$('#dlgPermitConfirmDelete').modal('show');

			$('#permitNumber').text(permitNumber);
			$('#btnDelete').data('permitId', id);
		};


		const deletePermit = (id) => {
			if (!id) {
				console.log('Permit ID is missing.');
				return;
			}

			$('.loading').show();

			const xhr = $.ajax({
				url: '/' + companyId + '/permits/' + id,
				method: 'DELETE',
				headers: { 'RequestVerificationToken': DataGrid.antiForgeryToken() },
			});

			xhr.done((response) => {
				if (response.data == 'OK') {
					tbl.ajax.reload(null, false);
				}
			});

			xhr.fail((xhr) => {
				alert(xhr.responseJSON?.message ?? 'The permit could not be deleted.');
			});

			xhr.always(() => {
				$('#btnDelete').data('permitId', '');
				$('.loading').hide();
			});

		};

	</script>
}
