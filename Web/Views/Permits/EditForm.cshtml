@using System.Text.Json
@model PermitPro.App.ViewModels.EditPermitViewModel

@{
	ViewData["Title"] = "Edit Permit";
	var companyId = ViewContext.RouteData.Values["company"] as string;
	var layoutJson = Model.LayoutJson ?? "{\"rows\":[]}";
	var isReadonly = Model.PermitStatus != PermitPro.Core.Enums.PermitStatusEnum.Draft;

	// Parse saved field values from PermitDataJson
	var savedFields = "{}";
	if (!string.IsNullOrWhiteSpace(Model.PermitDataJson))
	{
		try
		{
			using var doc = JsonDocument.Parse(Model.PermitDataJson);
			if (doc.RootElement.TryGetProperty("fields", out var fieldsEl))
				savedFields = fieldsEl.GetRawText();
		}
		catch { }
	}
}

<div class="mb-2 gap-4">
	<div class="row">
		<div id="form-permit" class="mb-3 col-12 col-md-9">

			<partial name="Partials/_ArchivedBanner" model="Model" />

			@* ── Status bar ───────────────────────────────────────────────────── *@
			<div class="alert alert-@Model.AlertBgColor mb-3" role="alert">
				<div class="d-flex flex-row align-items-center">
					<a class="me-3 text-dark" href="@Context.CompanyPathBase()/permits">
						<i class="fa-sharp fa-regular fa-chevron-left fa-xl"></i>
					</a>
					<h5 class="mb-0">@Model.PermitNo</h5>
					<div class="w-100 text-end">
						<span class="fw-semibold fs-6">@Model.PermitStatusDisplay</span>
					</div>
				</div>
			</div>

			@if (isReadonly)
			{
				<div class="alert alert-info d-flex align-items-center gap-2 mb-3" role="alert">
					<i class="fa-solid fa-lock"></i>
					<span>This permit is <strong>@Model.PermitStatus</strong> and cannot be edited.</span>
				</div>
			}

			@* ── Dynamic form ─────────────────────────────────────────────────── *@
			<form id="frmNewPermit" enctype="multipart/form-data">
				@Html.AntiForgeryToken()
				<input type="hidden" id="hdnPermitDataJson" name="permitDataJson" value="" />
				<input type="hidden" id="hdnSubmissionType" name="submissionType" value="draft" />

				@* ── Fixed header fields ──────────────────────────────────────── *@
				<div class="card shadow-sm border border-1 mb-3">
					<div class="card-header bg-light fw-semibold fs-6">
						<i class="fa-solid fa-circle-info me-2"></i> Permit Information
					</div>
					<div class="card-body">
						<div class="row g-3">
							<div class="col-12">
								<label class="form-label">Description of work <span class="text-danger">*</span></label>
								<textarea id="fldDescription" name="description" class="form-control" rows="2"
											 placeholder="Brief description of the work to be performed"
											 @(isReadonly ? "readonly" : "") required>@Model.PermitDescription</textarea>
							</div>
							<div class="col-md-6">
								<label class="form-label">Start date/time <span class="text-danger">*</span></label>
								<input type="datetime-local" id="fldStartDateTime" name="startDateTime"
									   class="form-control"
									   value="@(Model.PermitStartDateTime?.ToString("yyyy-MM-ddTHH:mm") ?? "")"
									   @(isReadonly ? "readonly" : "") required />
							</div>
							<div class="col-md-6">
								<label class="form-label">End date/time <span class="text-danger">*</span></label>
								<input type="datetime-local" id="fldEndDateTime" name="endDateTime"
									   class="form-control"
									   value="@(Model.PermitEndDateTime?.ToString("yyyy-MM-ddTHH:mm") ?? "")"
									   @(isReadonly ? "readonly" : "") required />
							</div>
						</div>
					</div>
				</div>

				<div class="card shadow-sm border border-1 mb-3">
					<div class="card-header bg-light fw-semibold fs-6">
						<i class="fa-solid fa-list-check me-2"></i> Permit Form
					</div>
					<div class="card-body">
						<div id="permitFormCanvas" class="mb-3"></div>
					</div>
				</div>

				@* ── File attachments ─────────────────────────────────────────── *@
				<div class="card shadow-sm border-0 mb-3">
					<div class="card-header bg-light fw-semibold fs-6">
						<i class="fa-solid fa-paperclip me-2"></i> Attachments
					</div>
					<div class="card-body">

						@* Uploaded files list *@
						<div id="uploadedFilesList" class="mb-3">
							<div class="text-muted small" id="filesLoading">
								<i class="fa-solid fa-spinner fa-spin me-1"></i> Loading…
							</div>
							<table class="table table-sm mb-0 align-middle d-none" id="tblAttachments">
								<thead class="table-light">
									<tr>
										<th>File</th>
										<th class="text-end" style="width:80px;">Size (kB)</th>
										<th style="width:110px;">Uploaded</th>
										@if (!isReadonly)
										{
											<th style="width:40px;"></th>
										}
									</tr>
								</thead>
								<tbody id="tblAttachmentsBody"></tbody>
							</table>
							<div class="text-muted small d-none text-center" id="filesEmpty">No attachments yet.</div>
						</div>

						@* Upload new files — Draft only *@
						@if (!isReadonly)
						{
							<div id="dropzone"
								 data-max-files="@Model.UploadMaxFileCount"
								 data-max-size="@Model.UploadFileSizeLimit"
								 data-accept="@string.Join(",", Model.UploadAllowedFileTypes.Select(t => "." + t))">
							</div>
						}
					</div>
				</div>

				@* ── Actions ──────────────────────────────────────────────────── *@
				@if (!isReadonly)
				{
					<div class="d-flex gap-2 justify-content-end mb-4">
						<a href="@Context.CompanyPathBase()/permits" class="btn btn-outline-secondary btn-sm align-content-center">
							<i class="fa-solid fa-xmark me-1"></i> Cancel
						</a>
						<button type="button" class="btn btn-outline-primary btn-sm" onclick="submitPermit('draft')">
							<i class="fa-solid fa-floppy-disk me-1"></i> Save Draft
						</button>
						<button type="button" class="btn btn-primary btn-sm" onclick="submitPermit('submit')">
							<i class="fa-solid fa-paper-plane me-1"></i> Submit
						</button>
					</div>
				}
			</form>

			@* ── Workflow history ─────────────────────────────────────────────── *@
			@if (Model.WorkflowHistories?.Any() == true)
			{
				<div class="accordion mb-3" id="accordionWfHistory">
					<div class="accordion-item border shadow-sm">
						<h2 class="accordion-header">
							<button class="accordion-button collapsed fw-semibold fs-6 bg-light" type="button"
									data-bs-toggle="collapse" data-bs-target="#collapseWfHistory"
									aria-expanded="false" aria-controls="collapseWfHistory">
								<i class="fa-solid fa-clock-rotate-left me-2 text-secondary"></i>
								Workflow History
								<span class="badge bg-secondary ms-2" style="font-size:.72rem;">@Model.WorkflowHistories.Count()</span>
							</button>
						</h2>
						<div id="collapseWfHistory" class="accordion-collapse collapse"
							 data-bs-parent="#accordionWfHistory">
							<div class="accordion-body p-0">
								<table class="table table-sm mb-0 align-middle">
									<thead class="table-light">
										<tr>
											<th style="padding-left:1rem;">Date</th>
											<th>Status</th>
											<th>By</th>
											<th>Comments</th>
										</tr>
									</thead>
									<tbody>
										@foreach (var h in Model.WorkflowHistories)
										{
											<tr>
												<td style="padding-left:1rem;white-space:nowrap;">
													<small class="text-muted">@h.DateCreated</small>
												</td>
												<td>
													<span class="badge bg-@h.StatusBgColor-subtle text-@h.StatusBgColor-emphasis border">@h.Status</span>
												</td>
												<td><small>@h.UserDisplayName</small></td>
												<td><small class="text-muted">@h.Comments</small></td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
			}

			@* ── Created / Updated info ───────────────────────────────────────── *@
			@if (!string.IsNullOrEmpty(Model.PermitCreatedByInfo))
			{
				<div class="text-muted mb-3">
					@if (!string.IsNullOrEmpty(Model.PermitCreatedByInfo))
					{
						<div class="small"><i class="fa-regular fa-user me-1"></i> Created by @Model.PermitCreatedByInfo</div>
					}
					@if (!string.IsNullOrEmpty(Model.PermitUpdatedByInfo))
					{
						<div class="small"><i class="fa-regular fa-pen-to-square me-1"></i> Last updated by @Model.PermitUpdatedByInfo</div>
					}
				</div>
			}
		</div>

		@* ── Right-side action panel ──────────────────────────────────────────── *@
		<div class="col-12 col-md-3">

			@* Approve / Reject *@
			@if (Model.PermitStatus == PermitPro.Core.Enums.PermitStatusEnum.Pending && Model.ExecuteWorkflowAction)
			{
				<div class="mb-4">
					<h6 class="fw-semibold text-uppercase text-muted mb-2">Permit Approval</h6>
					<div class="card shadow-sm">
						<div class="card-body">
							<div class="mb-3">
								<label class="form-label small">Comments</label>
								<textarea id="txtApprovalComments" class="form-control form-control-sm" rows="3"
											 placeholder="Optional comments…"></textarea>
							</div>
							<div class="d-flex gap-2">
								<button type="button" class="btn btn-sm btn-danger flex-grow-1 btn-workflow-action"
										  data-mode="reject">REJECT</button>
								<button type="button" class="btn btn-sm btn-primary flex-grow-1 btn-workflow-action"
										  data-mode="approve">APPROVE</button>
							</div>
						</div>
					</div>
				</div>
			}

			@* Mark as Closed *@
			@if (Model.PermitStatus == PermitPro.Core.Enums.PermitStatusEnum.Approved)
			{
				<div class="mb-4">
					<h6 class="fw-semibold text-uppercase text-muted mb-2">Close Permit</h6>
					<div class="card shadow-sm">
						<div class="card-body">
							<textarea id="txtCloseNotes" class="form-control form-control-sm mb-2" rows="2"
										 placeholder="Closing notes (optional)"></textarea>
							<button type="button" class="btn btn-sm btn-warning w-100 btn-mark-closed" data-id="@Model.PermitId">
								Mark as Closed
							</button>
						</div>
					</div>
				</div>
			}

			@* Certificates *@
			@if (Model.PermitId != Guid.Empty)
			{
				<div class="mb-4">
					<a href="@Context.CompanyPathBase()/permits/@Model.PermitId/certificates"
					   class="btn btn-sm btn-outline-secondary w-100">
						<i class="fa-solid fa-certificate me-2"></i> Certificates
					</a>
				</div>
			}

			@* Export PDF *@
			@if (Model.PermitStatus == PermitPro.Core.Enums.PermitStatusEnum.Draft
			  || Model.PermitStatus == PermitPro.Core.Enums.PermitStatusEnum.Approved
			  || Model.PermitStatus == PermitPro.Core.Enums.PermitStatusEnum.Closed)
			{
				<div class="mb-4">
					<button type="button" class="btn btn-sm btn-primary w-100 btn-export-pdf">
						<i class="fa-solid fa-file-pdf me-2"></i> Export to PDF
					</button>
				</div>
			}

		</div>
	</div>
</div>

@* ── Delete attachment confirm modal ─────────────────────────────────────── *@
<div class="modal fade" id="dlgDeleteAttachment" tabindex="-1" aria-labelledby="dlgDeleteAttachmentTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h6 class="modal-title fw-semibold" id="dlgDeleteAttachmentTitle">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> Delete Attachment
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Delete <strong id="dlgDeleteAttachmentName"></strong>? This cannot be undone.</p>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-danger" id="dlgDeleteAttachmentConfirm">
                    <i class="fa-solid fa-trash me-1"></i> Yes, delete
                </button>
            </div>
        </div>
    </div>
</div>

@section CustomCss {
<partial name="_FlatpickrStyles" />
}

@section Scripts {
<partial name="_FlatpickrScripts" />
<script>
	const LAYOUT   = @Html.Raw(layoutJson);
	const FIELDS   = @Html.Raw(savedFields);
	const READONLY = @Html.Raw(isReadonly ? "true" : "false");
	const SAVE_URL = '@Context.CompanyPathBase()/permits/form/@Model.PermitId';
	const METHOD   = 'PUT';
</script>
<partial name="~/Views/Permits/Partials/_NewFormScript.cshtml" />
	<script>
		// ── Approve / Reject ─────────────────────────────────────────────────────
		document.querySelectorAll('.btn-workflow-action').forEach(btn => {
			btn.addEventListener('click', async () => {
				const mode = btn.dataset.mode;
				const comments = document.getElementById('txtApprovalComments')?.value ?? '';
				const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

				const fd = new FormData();
				fd.append('PermitId', '@Model.PermitId');
				fd.append('Mode', mode);
				fd.append('Comments', comments);

				btn.disabled = true;
				try {
					const res = await fetch('@Context.CompanyPathBase()/permits/permit/status', {
						method: 'POST',
						headers: { 'RequestVerificationToken': token },
						body: fd,
					});
					if (res.ok) window.location.href = '@Context.CompanyPathBase()/permits';
					else showToast('Action failed: ' + await res.text(), 'danger');
				} catch (e) {
					showToast('Error: ' + e.message, 'danger');
				} finally {
					btn.disabled = false;
				}
			});
		});

		// ── Export PDF ────────────────────────────────────────────────────────────
		document.querySelector('.btn-export-pdf')?.addEventListener('click', async () => {
			const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
			const fd = new FormData();
			fd.append('Id', '@Model.PermitId');

			try {
				const res = await fetch('@Context.CompanyPathBase()/permits/permit/export/pdf', {
					method: 'POST',
					headers: { 'RequestVerificationToken': token },
					body: fd,
				});
				if (!res.ok) { showToast('Export failed.', 'danger'); return; }
				const blob = await res.blob();
				const url = URL.createObjectURL(blob);
				const a = document.createElement('a');
				a.href = url;
				a.download = '@(Model.PermitNo).pdf';
				a.click();
				URL.revokeObjectURL(url);
			} catch (e) {
				showToast('Export error: ' + e.message, 'danger');
			}
		});

		// ── Mark as Closed ────────────────────────────────────────────────────────
		document.querySelector('.btn-mark-closed')?.addEventListener('click', async () => {
			const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
			const notes = document.getElementById('txtCloseNotes')?.value ?? '';
			const fd = new FormData();
			fd.append('PermitId', '@Model.PermitId');
			fd.append('Notes', notes);

			try {
				const res = await fetch('@Context.CompanyPathBase()/permits/closed', {
					method: 'PUT',
					headers: { 'RequestVerificationToken': token },
					body: fd,
				});
				if (res.ok) window.location.href = '@Context.CompanyPathBase()/permits';
				else showToast('Could not close permit.', 'danger');
			} catch (e) {
				showToast('Error: ' + e.message, 'danger');
			}
		});

    // ── Attachment list ───────────────────────────────────────────────────
    const PERMIT_ID  = '@Model.PermitId';
    const IS_DRAFT   = @Html.Raw(!isReadonly ? "true" : "false");

    async function loadAttachments() {
        try {
            const res = await fetch(`@Context.CompanyPathBase()/permits/permit/${PERMIT_ID}/files`);
            if (!res.ok) return;
            const json = await res.json();
            // Endpoint returns a bare array (not wrapped in { Data: [...] })
            renderAttachments(Array.isArray(json) ? json : []);
        } catch { /* silent — non-critical */ }
    }

    function renderAttachments(files) {
        document.getElementById('filesLoading').classList.add('d-none');
        const tbody  = document.getElementById('tblAttachmentsBody');
        const table  = document.getElementById('tblAttachments');
        const empty  = document.getElementById('filesEmpty');

        tbody.innerHTML = '';

        if (!files.length) {
            table.classList.add('d-none');
            empty.classList.remove('d-none');
            return;
        }

        empty.classList.add('d-none');
        files.forEach(f => {
            const tr = document.createElement('tr');
            const deleteBtn = IS_DRAFT
                ? `<td class="text-end">
                      <button type="button" class="btn btn-sm btn-outline-danger"
                              onclick="confirmDeleteAttachment('${f.Id}', '${escAttr(f.FileName)}')"
                              title="Delete">
                          <i class="fa-solid fa-trash fa-xs"></i>
                      </button>
                   </td>`
                : '';
            tr.innerHTML = `
                <td>
                    <a href="/attachments/permits/${f.PermitId}/${escAttr(f.FileName)}"
                       target="_blank" class="text-decoration-none">
                        <i class="fa-solid fa-file me-1 text-muted"></i>${escHtml(f.FileName)}
                    </a>
                </td>
                <td class="text-end text-muted small">${escHtml(f.FileSize)}</td>
                <td class="text-muted small">${escHtml(f.CreatedWhen)}</td>
                ${deleteBtn}`;
            tbody.appendChild(tr);
        });

        table.classList.remove('d-none');
    }

    let bsDeleteAttachModal = null;
    document.addEventListener('DOMContentLoaded', () => {
        bsDeleteAttachModal = new bootstrap.Modal(document.getElementById('dlgDeleteAttachment'));
    });

    function confirmDeleteAttachment(id, name) {
        document.getElementById('dlgDeleteAttachmentName').textContent = name;
        document.getElementById('dlgDeleteAttachmentConfirm').onclick = () => {
            bsDeleteAttachModal.hide();
            deleteAttachment(id);
        };
        bsDeleteAttachModal.show();
    }

    async function deleteAttachment(id) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        const fd = new FormData();
        fd.append('FileId', id);

        try {
            const res = await fetch(`@Context.CompanyPathBase()/permits/attachments/remove`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token },
                body: fd,
            });
            if (res.ok) loadAttachments();
            else showToast('Failed to delete attachment.', 'danger');
        } catch { showToast('Error deleting attachment.', 'danger'); }
    }

    function escHtml(s) {
        if (s == null) return '';
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }
    function escAttr(s) {
        if (s == null) return '';
        return String(s).replace(/"/g,'&quot;').replace(/'/g,'&#039;');
    }

    document.addEventListener('DOMContentLoaded', loadAttachments);
	</script>
}
