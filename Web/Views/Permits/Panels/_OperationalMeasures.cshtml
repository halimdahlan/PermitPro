@model EditPermitViewModel

<h2 class="accordion-header">
	<button class="accordion-button fw-semibold text-uppercase collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse5" aria-expanded="false" aria-controls="collapse5">
		Operational Measures
	</button>
</h2>
<div id="collapse5" class="accordion-collapse collapse" data-bs-parent="#accordionPermit">
	<div class="accordion-body" style="position: relative;">
		@if (Model.PermitStatus != PermitPro.Core.Enums.PermitStatusEnum.Draft)
		{
			<div class="edit-disable"></div>
		}
		<div class="mb-3">
			<h6 class="text-uppercase">Mechanical</h6>
			<div class="d-flex flex-md-row flex-column justify-content-evenly">
				<div class="form-group flex-grow-1 me-md-3">
					<label class="form-label">Equipment</label>
					<input type="text" class="form-control" id="tbOpMeasureMech1" name="tbOpMeasureMech1" autocomplete="off" data-control="textbox" />
				</div>
				<div class="form-group flex-grow-1 ms-md-3">
					<label class="form-label">ID/Tag number</label>
					<input type="text" class="form-control" id="tbOpMeasureMech2" name="tbOpMeasureMech2" autocomplete="off" data-control="textbox" />
				</div>
			</div>
			<ul class="list-group list-group-flush">
				<li class="list-group-item d-flex justify-content-between align-items-center">
					<div class="me-auto">
						<div><label for="swOpMeasure3">Pressure free</label></div>
					</div>
					<div class="">
						<div class="form-check form-switch fc-switch">
							<input type="checkbox" role="switch" class="form-check-input" id="swOpMeasureMech1" name="swOpMeasureMech1" data-control="switch" data-elem="pressureFree" />
						</div>
					</div>
				</li>
				<li class="list-group-item d-flex justify-content-between align-items-center">
					<div class="me-auto">
						<div><label for="swOpMeasure4">Empty</label></div>
					</div>
					<div class="">
						<div class="form-check form-switch fc-switch">
							<input type="checkbox" role="switch" class="form-check-input" id="swOpMeasureMech2" name="swOpMeasureMech2" data-control="switch" data-elem="empty" />
						</div>
					</div>
				</li>
				<li class="list-group-item d-flex justify-content-between align-items-center">
					<div class="me-auto">
						<div><label for="swOpMeasure5">Disconnected</label></div>
					</div>
					<div class="">
						<div class="form-check form-switch fc-switch">
							<input type="checkbox" role="switch" class="form-check-input" id="swOpMeasureMech3" name="swOpMeasureMech3" data-control="switch" data-elem="disconnected" />
						</div>
					</div>
				</li>
				<li class="list-group-item d-flex justify-content-between align-items-center">
					<div class="me-auto">
						<div><label for="swOpMeasure6">Blank off</label></div>
					</div>
					<div class="">
						<div class="form-check form-switch fc-switch">
							<input type="checkbox" role="switch" class="form-check-input" id="swOpMeasureMech4" name="swOpMeasureMech4" data-control="switch" data-elem="blankOff" />
						</div>
					</div>
				</li>
				<li class="list-group-item d-flex justify-content-between align-items-center">
					<div class="me-auto">
						<div><label for="swOpMeasure7">Locked off</label></div>
					</div>
					<div class="">
						<div class="form-check form-switch fc-switch">
							<input type="checkbox" role="switch" class="form-check-input" id="swOpMeasureMech5" name="swOpMeasureMech5" data-control="switch" data-elem="lockedOff" />
						</div>
					</div>
				</li>
				<li class="list-group-item d-flex justify-content-between align-items-center">
					<div class="me-auto">
						<div><label for="swOpMeasure8">Flushed</label></div>
					</div>
					<div class="">
						<div class="form-check form-switch fc-switch">
							<input type="checkbox" role="switch" class="form-check-input" id="swOpMeasureMech6" name="swOpMeasureMech6" data-control="switch" data-elem="flushed" />
						</div>
					</div>
				</li>
				<li class="list-group-item d-flex justify-content-between align-items-center">
					<div class="me-auto">
						<div><label for="swOpMeasure9">Ventilated</label></div>
					</div>
					<div class="">
						<div class="form-check form-switch fc-switch">
							<input type="checkbox" role="switch" class="form-check-input" id="swOpMeasureMech7" name="swOpMeasureMech7" data-control="switch" data-elem="ventilated" />
						</div>
					</div>
				</li>
				<li class="list-group-item d-flex justify-content-between align-items-center">
					<div class="me-auto">
						<div><label for="swOpMeasure11">Other (please specify)</label></div>
						<input type="text" class="form-control swOpMeasureMech8" id="tbOpMeasureMech8" name="tbOpMeasureMech8" autocomplete="off" data-control="textbox" />
					</div>
					<div class="">
						<div class="form-check form-switch fc-switch">
							<input type="checkbox" role="switch" class="form-check-input" id="swOpMeasureMech8" name="swOpMeasureMech8" data-control="switch" data-elem="other" />
						</div>
					</div>
				</li>
			</ul>
		</div>
		<hr />
		<div class="">
			<h6 class="text-uppercase">Electrical</h6>
			<div class="d-flex flex-md-row flex-column justify-content-evenly">
				<div class="form-group flex-grow-1 me-md-3">
					<label class="form-label" for="tbOpMeasure12">Equipment/Electrical motor</label>
					<input type="text" class="form-control" id="tbOpMeasureElec1" name="tbOpMeasureElec1" autocomplete="off" data-control="textbox" />
				</div>
				<div class="form-group flex-grow-1 ms-md-3">
					<label class="form-label" for="tbOpMeasure13">ID/Tag number</label>
					<input type="text" class="form-control" id="tbOpMeasureElec2" name="tbOpMeasureElec2" autocomplete="off" data-control="textbox" />
				</div>
			</div>
			<hr />
			<ul class="list-group list-group-flush">
				<li class="list-group-item d-flex justify-content-between align-items-center">
					<div class="me-auto">
						<div><label for="swOpMeasure14">Locked off</label></div>
					</div>
					<div class="">
						<div class="form-check form-switch fc-switch">
							<input type="checkbox" role="switch" class="form-check-input" id="swOpMeasureElec1" name="swOpMeasureElec1" data-control="switch" data-elem="lockedOff" />
						</div>
					</div>
				</li>
				<li class="list-group-item d-flex justify-content-between">
					<div class="me-auto">
						<div><label for="swOpMeasure15">Isolated</label></div>
					</div>
					<div class="">
						<div class="form-check form-switch fc-switch">
							<input type="checkbox" role="switch" class="form-check-input" id="swOpMeasureElec2" name="swOpMeasureElec2" data-control="switch" data-elem="isolated" />
						</div>
					</div>
				</li>
				<li class="list-group-item d-flex justify-content-between align-items-center border-bottom-0">
					<div class="me-auto">
						<div><label for="swOpMeasure16">See Isolation Certificate</label></div>
					</div>
					<div class="">
						<div class="form-check form-switch fc-switch">
							<input type="checkbox" role="switch" class="form-check-input" id="swOpMeasureElec3" name="swOpMeasureElec3" data-control="switch" data-elem="isolationCertificate" />
						</div>
					</div>
				</li>
				<li class="list-group-item d-flex justify-content-between align-items-center border-bottom-0">
					<div class="me-auto">
						<div><label for="numOpMeasure17">No. of Isolation Certificate(s)</label></div>
					</div>
					<div class="">
						<input type="number" class="form-control" id="numOpMeasureElec1" name="numOpMeasureElec1" step="1" data-control="numeric" value="0" min="0" max="500" />
					</div>
				</li>
			</ul>
		</div>
		<hr />
		<div class="">
			<h6 class="text-uppercase">Instrument &lt; 24V</h6>
			<div class="d-flex flex-md-row flex-column justify-content-evenly">
				<div class="form-group flex-grow-1 me-md-3">
					<label class="form-label" for="txOpMeasureInst1">Instrument</label>
					<input type="text" class="form-control" id="tbOpMeasureInst1" name="tbOpMeasureInst1" autocomplete="off" data-control="textbox" />
				</div>
				<div class="form-group flex-grow-1 ms-md-3">
					<label class="form-label" for="txOpMeasureInst2">ID/Tag number</label>
					<input type="text" class="form-control" id="tbOpMeasureInst2" name="tbOpMeasureInst2" autocomplete="off" data-control="textbox" />
				</div>
			</div>
			<ul class="list-group list-group-flush">
				<li class="list-group-item d-flex justify-content-between align-items-center">
					<div class="me-auto">
						<div><label for="swPpeWorkArea20">Locked off</label></div>
					</div>
					<div class="">
						<div class="form-check form-switch fc-switch">
							<input type="checkbox" role="switch" class="form-check-input" id="swOpMeasureInst1" name="swOpMeasureInst1" data-control="switch" data-elem="lockedOff" />
						</div>
					</div>
				</li>
				<li class="list-group-item d-flex justify-content-between align-items-center">
					<div class="me-auto">
						<div><label for="swPpeWorkArea21">Isolated</label></div>
					</div>
					<div class="">
						<div class="form-check form-switch fc-switch">
							<input type="checkbox" role="switch" class="form-check-input" id="swOpMeasureInst2" name="swOpMeasureInst2" data-control="switch" data-elem="isolated" />
						</div>
					</div>
				</li>
				<li class="list-group-item d-flex justify-content-between align-items-center border-bottom-0">
					<div class="me-auto">
						<div><label for="swPpeWorkArea22">Disconnected</label></div>
					</div>
					<div class="">
						<div class="form-check form-switch fc-switch">
							<input type="checkbox" role="switch" class="form-check-input" id="swOpMeasureInst3" name="swOpMeasureInst3" data-control="switch" data-elem="disconnected" />
						</div>
					</div>
				</li>
				<li class="list-group-item d-flex justify-content-between align-items-center border-bottom-0">
					<div class="me-auto">
						<div><label for="swPpeWorkArea23">Bypass</label></div>
					</div>
					<div class="">
						<div class="form-check form-switch fc-switch">
							<input type="checkbox" role="switch" class="form-check-input" id="swOpMeasureInst4" name="swOpMeasureInst4" data-control="switch" data-elem="bypass" />
						</div>
					</div>
				</li>
				<li class="list-group-item d-flex justify-content-between align-items-center border-bottom-0">
					<div class="me-auto">
						<div><label for="numOpMeasure24">No. of Isolation Certificate(s)</label></div>
					</div>
					<div class="">
						<input type="number" class="form-control" id="numOpMeasureInst1" name="numOpMeasureInst1" step="1" data-control="numeric" value="0" min="0" max="500" />
					</div>
				</li>
			</ul>
		</div>
		<hr />
		<div>
			<ul class="list-group list-group-flush">
				<li class="list-group-item d-flex justify-content-between align-items-center">
					<div class="me-auto">
						<div><label for="swPpeWorkArea24">Shutdown system operational?</label></div>
					</div>
					<div class="">
						<div class="form-check form-switch fc-switch">
							<input type="checkbox" role="switch" class="form-check-input" id="swOpMeasureInst5" name="swOpMeasureInst5" data-control="switch" data-elem="shutdownSystemOperational" />
						</div>
					</div>
				</li>
				<li class="list-group-item d-flex justify-content-between align-items-center">
					<div class="me-auto">
						<div><label for="swPpeWorkArea25">Fire protection system operational?</label></div>
					</div>
					<div class="">
						<div class="form-check form-switch fc-switch">
							<input type="checkbox" role="switch" class="form-check-input" id="swOpMeasureInst6" name="swOpMeasureInst6" data-control="switch" data-elem="fireProtectionSysOperational" />
						</div>
					</div>
				</li>
				<li class="list-group-item d-flex justify-content-between align-items-center border-bottom-0">
					<div class="me-auto">
						<div><label for="swPpeWorkArea26">Automatic fire protection system operational?</label></div>
					</div>
					<div class="">
						<div class="form-check form-switch fc-switch">
							<input type="checkbox" role="switch" class="form-check-input" id="swOpMeasureInst7" name="swOpMeasureInst7" data-control="switch" data-elem="autoFireProtectionSysOperational" />
						</div>
					</div>
				</li>
			</ul>
		</div>
		<hr />
		<div>
			<div class="mb-2">
				<label class="form-label" for="tbOpMeasure27">Any other measures?</label>
				<textarea class="form-control" id="txtOpMeasureInst1" name="txtOpMeasureInst1" data-control="textarea" rows="2"></textarea>
			</div>
		</div>
		<hr />
		<div>
			<h6 class="text-uppercase">PTW Handover to Holder</h6>
			<ul class="list-group list-group-flush">
				<li class="list-group-item d-flex justify-content-between align-items-center">
					<div class="me-auto">
						<div><label for="swPpeWorkArea28">Is aware of the safety instructions as in the Terminal Safety Manual?</label></div>
					</div>
					<div class="">
						<div class="form-check form-switch fc-switch">
							<input type="checkbox" role="switch" class="form-check-input" id="swPpeWorkAreaInst8" name="swPpeWorkAreaInst8" data-control="switch" />
						</div>
					</div>
				</li>
				<li class="list-group-item d-flex justify-content-between align-items-center">
					<div class="me-auto">
						<div><label for="swPpeWorkArea29">Is aware of the safety instructions as in the Permit to Work and associated certificates?</label></div>
					</div>
					<div class="">
						<div class="form-check form-switch fc-switch">
							<input type="checkbox" role="switch" class="form-check-input" id="swPpeWorkAreaInst9" name="swPpeWorkAreaInst9" data-control="switch" />
						</div>
					</div>
				</li>
			</ul>
		</div>
		<hr />
		<div class="p-3 border border-info">
			<h6 class="text-uppercase">SIGNED-OFF</h6>
		</div>
	</div>
</div>
