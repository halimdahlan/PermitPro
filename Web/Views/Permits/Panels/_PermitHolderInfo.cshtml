@model EditPermitViewModel

<h2 class="accordion-header">
	<button class="accordion-button fw-semibold text-uppercase collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse3" aria-expanded="false" aria-controls="collapse3">
		Permit Holder Information
	</button>
</h2>
<div id="collapse3" class="accordion-collapse collapse" data-bs-parent="#accordionPermit">
	<div class="accordion-body" style="position: relative;">
		@if (Model.PermitStatus != PermitPro.Core.Enums.PermitStatusEnum.Draft)
		{
			<div class="edit-disable"></div>
		}
		<div class="form-group mb-3">
			<div class="form-floating">
				<input type="text" class="form-control" id="tbPermitHolderInfo1" name="tbPermitHolderInfo1" autocomplete="off" data-control="textbox" placeholder=" " />
				<label for="tbPermitHolderInfo1">Name</label>
			</div>
		</div>
		<div class="form-group mb-3">
			<div class="form-floating">
				<input type="text" class="form-control" id="tbPermitHolderInfo2" name="tbPermitHolderInfo2" autocomplete="off" data-control="textbox" placeholder=" " />
				<label for="tbPermitHolderInfo2">Company</label>
			</div>
		</div>
		<div class="form-group mb-3">
			<div class="form-floating">
				<input type="number" class="form-control" id="tbPermitHolderInfo3" name="tbPermitHolderInfo3" step="1" data-control="numeric" value="0" min="0" max="500" placeholder=" " />
				<label for="tbPermitHolderInfo3">Number of staff present</label>
			</div>
		</div>
		<div class="form-group mb-5">
			<div class="form-floating">
				<textarea class="form-control" id="tbPermitHolderInfo4" name="tbPermitHolderInfo4" data-control="textarea" rows="5" placeholder=" "></textarea>
				<label for="tbPermitHolderInfo4">Additional staff</label>
			</div>
		</div>
		<div class="text-danger">
			<h6 class="fw-semibold">INSTRUCTIONS FOR HOLDER</h6>
			<div class="text-danger">
				Work must be performed according to <strong>ALL</strong> safety instructions. Mobile phones are strictly prohibited from the terminal area.
			</div>
		</div>
	</div>
</div>