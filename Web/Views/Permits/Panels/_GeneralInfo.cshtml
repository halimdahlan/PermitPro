@model EditPermitViewModel

<h2 class="accordion-header">
	<button class="accordion-button fw-semibold text-uppercase" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
		General Information
	</button>
</h2>
<div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#accordionPermit">
	<div class="accordion-body" style="position: relative;">
		@if (Model.PermitStatus != PermitPro.Core.Enums.PermitStatusEnum.Draft)
		{
			<div class="edit-disable"></div>
		}
		<div class="form-group mb-3">
			<label class="form-label">Location</label>
			<div id="ddtLocation" data-control="tree" data-url="/@Model.CompanyId/sites/tree" data-placeholder="(select location)"></div>
		</div>
		<div class="mb-3">
			<label class="form-label">Description of work</label>
			<textarea class="form-control" id="tbPermitDesc" name="tbPermitDesc" data-control="textarea" rows="2"></textarea>
		</div>
		<div class="d-flex flex-md-row flex-column mb-3 w-100">
			<div class="flex-grow-1 me-md-3">
				<label class="form-label">Start date/time</label>
				<input type="text" class="form-control" id="startDateTime" name="startDateTime" autocomplete="off" data-control="date" data-change="onStartDateChange" />
			</div>
			<div class="flex-grow-1 ms-md-3 mt-3 mt-md-0">
				<label class="form-label">End date/time</label>
				<input type="text" class="form-control" id="endDateTime" name="endDateTime" autocomplete="off" data-control="date" />
			</div>
		</div>
		<hr />
		<div class="mb-4">
			<div class="mb-3">Associated certificate</div>
			<div class="d-flex flex-md-row flex-column justify-content-evenly">
				<div class="w-33">
					<div>
						<div class="form-check fc-check">
							<input type="checkbox" class="form-check-input certificates" id="chkCertHotWork" name="chkCertHotWork" data-control="checkbox" data-certname="hotwork|A|HOT WORK" data-change="onChangeCertificate" />
							<label class="form-check-label" for="chkCertHotWork">Hot Work</label>
						</div>
					</div>
					<div>
						<div class="form-check fc-check">
							<input type="checkbox" class="form-check-input certificates" id="chkCertConfinedSpace" name="chkCertConfinedSpace" data-control="checkbox" data-certname="confinedspace|B|CONFINED SPACE" data-change="onChangeCertificate" />
							<label class="form-check-label" for="chkCertConfinedSpace">Confined Space</label>
						</div>
					</div>
					<div>
						<div class="form-check fc-check">
							<input type="checkbox" class="form-check-input certificates" id="chkCertRadiation" name="chkCertRadiation" data-control="checkbox" data-certname="radiation|C|RADIATION" data-change="onChangeCertificate" />
							<label class="form-check-label" for="chkCertRadiation">Radiation</label>
						</div>
					</div>
				</div>
				<div class="w-33">
					<div>
						<div class="form-check fc-check">
							<input type="checkbox" class="form-check-input certificates" id="chkCertExcavation" name="chkCertExcavation" data-control="checkbox" data-certname="excavation|D|EXCAVATION" data-change="onChangeCertificate" />
							<label class="form-check-label" for="chkCertExcavation">Excavation</label>
						</div>
					</div>
					<div>
						<div class="form-check fc-check">
							<input type="checkbox" class="form-check-input certificates" id="chkCertIsolation" name="chkCertIsolation" data-control="checkbox" data-certname="isolation|E|ISOLATION" data-change="onChangeCertificate" />
							<label class="form-check-label" for="chkCertIsolation">Isolation</label>
						</div>
					</div>
					<div>
						<div class="form-check fc-check">
							<input type="checkbox" class="form-check-input certificates" id="chkCertF" name="chkCertF" data-control="checkbox" data-certname="methodStatement|F|METHOD STATEMENT" data-change="onChangeCertificate" />
							<label class="form-check-label" for="chkCertF">Method Statement</label>
						</div>
					</div>
				</div>
				<div class="w-33">
					<div>
						<div class="form-check fc-check">
							<input type="checkbox" class="form-check-input certificates" id="chkCertG" name="chkCertG" data-control="checkbox" data-certname="liftingHoisting|G|LIFTING &amp; HOISTING" data-change="onChangeCertificate" />
							<label class="form-check-label" for="chkCertG">Lifting &amp; Hoisting</label>
						</div>
					</div>
					<div>
						<div class="form-check fc-check">
							<input type="checkbox" class="form-check-input certificates" id="chkCertH" name="chkCertH" data-control="checkbox" data-certname="override|H|OVERRIDE" data-change="onChangeCertificate" />
							<label class="form-check-label" for="chkCertH">Override</label>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>