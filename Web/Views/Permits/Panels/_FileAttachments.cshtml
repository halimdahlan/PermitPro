@model EditPermitViewModel

@{
    var isDraft = Model.PermitStatus == PermitPro.Core.Enums.PermitStatusEnum.Draft;
    var hasPermit = Model.PermitId != Guid.Empty;
    var accept = string.Join(",", Model.UploadAllowedFileTypes?.Select(t => "." + t) ?? []);
}

<h2 class="accordion-header">
	<button class="accordion-button collapsed fw-semibold text-uppercase" type="button" data-bs-toggle="collapse" data-bs-target="#collapse8" aria-expanded="false" aria-controls="collapse8">
		File Attachments
	</button>
</h2>
<div id="collapse8" class="accordion-collapse collapse" data-bs-parent="#accordionPermit"
	  data-panel-name="fileAttachments">
	<div class="accordion-body">

		@* Uploaded files list (Edit loads it; a new permit has no files yet, so its spinner never cleared) *@
		@if (hasPermit)
		{
		<div class="mb-3">
			<div class="text-muted small" id="filesLoading">
				<i class="fa-solid fa-spinner fa-spin me-1"></i> Loading…
			</div>
			<table class="table table-sm mb-0 align-middle d-none" id="tblAttachments">
				<thead class="table-light">
					<tr>
						<th>File</th>
						<th class="text-end" style="width: 80px;">Size (kB)</th>
						<th style="width: 120px;">Uploaded</th>
						@if (isDraft)
						{
							<th style="width: 40px;"></th>
						}
					</tr>
				</thead>
				<tbody id="tblAttachmentsBody"></tbody>
			</table>
			<div class="text-muted small d-none text-center" id="filesEmpty">No attachments yet.</div>
		</div>
		}

		@* Dropzone — only available on existing Draft permits *@
		@if (isDraft && hasPermit)
		{
			<div id="dropzone"
				 data-max-files="@Model.UploadMaxFileCount"
				 data-max-size="@Model.UploadFileSizeLimit"
				 data-accept="@accept">
			</div>
		}
		else if (!hasPermit)
		{
			<p class="text-muted small mb-0">Save the permit first to add attachments.</p>
		}

		@if (isDraft)
		{
			<div class="mt-2">
				<small class="text-muted">Allowed file types: @(string.Join(", ", Model.UploadAllowedFileTypes ?? []).ToUpper())</small>
			</div>
		}
	</div>
</div>
