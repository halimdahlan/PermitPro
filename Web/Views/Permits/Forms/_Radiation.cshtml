<!-- Modal: FORM C /////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////// -->
<div class="modal fade" id="dlgFormC" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="dlgFormCLabel" aria-hidden="true">
	<div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
		<div class="modal-content">
			<div class="modal-header bg-primary-soft">
				<div class="modal-title w-100" id="dlgFormCLabel">
					<div class="d-flex flex-row align-items-center">
						<!--div-- class="avatar">
							<span class="avatar-title rounded-circle bg-info" style="font-size: 22.75px !important; font-weight: 700 !important;">C</span>
						</!--div-->
						<img title="(C) RADIATION" src="/img/icons/certs/radiation.png" style="width:40px;height:40px;" />
						<span class="ms-3 dialog-title">RADIATION</span>
					</div>
				</div>
				<a href="" class="text-dark no-loading" data-bs-dismiss="modal" aria-label="Close"><i class="fa-sharp fa-solid fa-xmark fa-xl"></i></a>
			</div>
			<div class="modal-body">

				<div class="bg-light p-2 mb-3 border-top border-bottom border-secondary">
					<h6 class="mb-0">GENERAL INFORMATION</h6>
				</div>
				<div class="px-2 mb-4">
					<div class="mb-3">
						Only valid for routine activities ionise radiation source. (Only to be completed by authorised persons).
					</div>
				</div>

				<div class="bg-light p-2 mb-3 border-top border-bottom border-secondary">
					<h6 class="mb-0">To be completed by the Permit Holder</h6>
				</div>
				<div class="px-2 mb-4">
					<div class="mb-3">
						<div class="form-floating">
							<input type="text" class="form-control" id="tbxFormC-MaterialUsed" name="tbxFormC-MaterialUsed" autocomplete="off" data-control="textbox" placeholder=" " />
							<label for="tbxFormC-MaterialUsed">Radioactive material being used, please specify</label>
						</div>
					</div>
					<div class="d-flex flex-row mb-3">
						<div class="flex-grow-1">
							<div class="form-floating">
								<input type="text" class="form-control" id="tbxFormC-MaterialActivity" name="tbxFormC-MaterialActivity" autocomplete="off" data-control="textbox" placeholder=" " />
								<label for="tbxFormC-MaterialActivity">Activity of material</label>
							</div>
						</div>
						<div class="ms-3 pt-5">
							<span>Bq/mCi</span>
						</div>
					</div>
					<div class="mb-3">
						<div class="form-floating">
							<input type="text" class="form-control" id="tbxFormC-ContainedWithin" name="tbxFormC-ContainedWithin" autocomplete="off" data-control="textbox" placeholder=" " />
							<label for="tbxFormC-ContainedWithin">Contained within</label>
						</div>
					</div>
					<div class="mb-3">
						<div class="d-flex flex-column flex-md-row">
							<div class="me-5">
								<div style="padding-top: 4px;">
									<div class="form-check fc-check">
										<input type="checkbox" class="form-check-input" id="chkFormC-XRayMachine" name="chkFormC-XRayMachine" data-control="checkbox" />
										<label class="form-check-label" for="chkFormC-XRayMachine">X-ray machine</label>
									</div>
								</div>
							</div>
							<div class="mt-3 mt-md-0">
								<div class="d-flex flex-row align-items-center mb-2 ms-4 ms-md-0">
									<label style="min-width: 140px;">Manufacturer/model</label>
									<div class="ms-3">
										<input type="text" class="form-control" id="tbxFormC-ManufacturerModel" name="tbxFormC-ManufacturerModel" autocomplete="off" data-control="textbox" />
									</div>
								</div>
								<div class="d-flex flex-row align-items-center mb-2 ms-4 ms-md-0">
									<label style="min-width: 140px;">Max tube voltage</label>
									<div class="ms-3 me-3">
										<input type="text" class="form-control" id="tbxFormC-MaxTubeVoltage" name="tbxFormC-MaxTubeVoltage" autocomplete="off" data-control="textbox" />
									</div>
									<div>kV</div>
								</div>
								<div class="d-flex flex-row align-items-center ms-4 ms-md-0">
									<label style="min-width: 140px;">Max tube current</label>
									<div class="ms-3 me-3">
										<input type="text" class="form-control" id="tbxFormC-MaxTubeCurrent" name="tbxFormC-MaxTubeCurrent" autocomplete="off" data-control="textbox" />
									</div>
									<div>mA</div>
								</div>
							</div>
						</div>
					</div>
					<div class="mb-3">
						<div class="d-flex flex-column flex-md-row">
							<div class="me-5">
								<div style="padding-top: 4px;">
									<div class="form-check fc-check">
										<input type="checkbox" class="form-check-input" id="chkFormC-OtherEquip" name="chkFormC-OtherEquip" data-control="checkbox" />
										<label class="form-check-label" for="chkFormC-OtherEquip">Other equipment, specify</label>
									</div>
								</div>
							</div>
							<div class="mt-3 mt-md-0">
								<div class="d-flex flex-row align-items-center mb-2 ms-4 ms-md-0">
									<div style="margin-left: 83px;">
										<input type="text" class="form-control" id="tbxFormC-OtherEquip" name="tbxFormC-OtherEquip" autocomplete="off" data-control="textbox" />
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="mb-3">
						<div class="form-floating">
							<textarea class="form-control" id="txtFormC-EquipAdditionalInfo" name="txtFormC-EquipAdditionalInfo" data-control="textarea" rows="2" placeholder=" "></textarea>
							<label for="txtFormC-EquipAdditionalInfo">Additional information about operation of equipment</label>
						</div>
					</div>
					<div class="mb-3">
						<div class="mb-2">
							Radiation equipment will be used between
						</div>
						<div class="d-flex flex-column flex-md-row justify-content-evenly mb-3">
							<div class="w-100 me-0 me-md-3 mb-3 mb-md-0">
								<div class="form-floating">
									<input type="text" class="form-control" id="tmpFormC-TimeUseFrom" name="tmpFormC-TimeUseFrom" autocomplete="off" data-control="time" placeholder=" " />
									<label for="tmpFormC-TimeUseFrom">From</label>
								</div>
							</div><div class="w-100 ms-0 ms-md-3">
								<div class="form-floating">
									<input type="text" class="form-control" id="tmpFormC-TimeUseTo" name="tmpFormC-TimeUseTo" autocomplete="off" data-control="time" placeholder=" " />
									<label for="tmpFormC-TimeUseTo">To</label>
								</div>
							</div>
						</div>
					</div>
					<div class="mb-3">
						<div class="form-floating">
							<textarea class="form-control" id="txtFormC-PreventMeasures" name="txtFormC-PreventMeasures" data-control="textarea" rows="2" placeholder=" "></textarea>
							<label for="txtFormC-PreventMeasures">Measures to prevent and mitigate exposure</label>
						</div>
					</div>
					<div class="mb-4">
						<div class="form-floating">
							<textarea class="form-control" id="txtFormC-AdditionalControl" name="txtFormC-AdditionalControl" data-control="textarea" rows="2" placeholder=" "></textarea>
							<label for="txtFormC-AdditionalControl">Additional controls required</label>
						</div>
					</div>
					<div class="text-center">
						<h6>ALL IRREGULARITIES DURING WORK MUST BE REPORTED IMMEDIATELY TO THE PERMIT HOLDER</h6>
					</div>
				</div>

				<div class="bg-light p-2 mb-3 border-top border-bottom border-secondary">
					<h6 class="mb-0">Validity of the Radiation Permit</h6>
				</div>
				<div class="px-2 mb-4">
					<div class="mb-3">
						I certify that I have reviewed the proposed work and I am satisfied that it is adequately described on the
						Permit to Work documents and that the precautions detailed in this certificate are adequate and clearly defined.
					</div>
					<div class="mb-3">
						<div class="mb-2">
							Radiation Permit is allowed between
						</div>
						<div class="d-flex flex-column flex-md-row justify-content-evenly mb-3">
							<div class="w-100 me-0 me-md-3 mb-3 mb-md-0">
								<div class="form-floating">
									<input type="text" class="form-control" id="tmpFormC-TimeAllowedFrom" name="tmpFormC-TimeAllowedFrom" autocomplete="off" data-control="time" placeholder=" " />
									<label for="tmpFormC-TimeAllowedFrom">From</label>
								</div>
							</div><div class="w-100 ms-0 ms-md-3">
								<div class="form-floating">
									<input type="text" class="form-control" id="tmpFormC-TimeAllowedTo" name="tmpFormC-TimeAllowedTo" autocomplete="off" data-control="time" placeholder=" " />
									<label for="tmpFormC-TimeAllowedTo">To</label>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="bg-light p-2 mb-3 border-top border-bottom border-secondary">
					<h6 class="mb-0">Radiation Certificate is Withdrawn</h6>
				</div>
				<div class="px-2 mb-4">
					<div>
						<div class="d-flex flex-row align-items-center">
							<div class="me-5">
								<div class="form-check form-switch fc-switch">
									<input type="checkbox" role="switch" class="form-check-input" id="swtFormC-Withdrawn" name="swtFormC-Withdrawn" data-control="switch" data-change="onChangeWithdrawnFormC" />
								</div>
							</div>
							<label class="form-label me-3" for="tbxFormD-Withdrawn-Reason">Reason</label>
							<div class="flex-grow-1">
								<input type="text" class="form-control" id="tbxFormC-Withdrawn-Reason" name="tbxFormC-Withdrawn-Reason" autocomplete="off" data-control="textbox" disabled />
							</div>
						</div>
					</div>
				</div>

			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
				<button type="button" class="btn btn-sm btn-primary" id="btnSaveFormC" data-bs-dismiss="modal">Save changes</button>
			</div>
		</div>
	</div>
</div>
<!-- ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////// -->
