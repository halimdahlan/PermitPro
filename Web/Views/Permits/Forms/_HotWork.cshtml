<!-- Modal: FORM A /////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////// -->
<div class="modal fade" id="dlgFormA" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="dlgFormALabel" aria-hidden="true">
	<div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
		<div class="modal-content">
			<div class="modal-header bg-primary-soft">
				<div class="modal-title w-100" id="dlgFormALabel">
					<div class="d-flex flex-row align-items-center">
						<!--div class="avatar">
							<span class="avatar-title rounded-circle bg-info" style="font-size: 22.75px !important; font-weight: 700 !important;">A</span>
						</div-->
						<img title="(A) HOT WORK" src="/img/icons/certs/hotwork.png" style="width:40px;height:40px;" />
						<span class="ms-3 dialog-title">HOT WORK</span>
					</div>
				</div>
				<a href="" class="text-dark no-loading" data-bs-dismiss="modal" aria-label="Close"><i class="fa-sharp fa-solid fa-xmark fa-xl"></i></a>
			</div>
			<div class="modal-body">

				<div class="bg-light p-2 mb-3 border-top border-bottom border-secondary">
					<h6 class="mb-0">GENERAL INFORMATION</h6>
				</div>
				<div class="d-flex flex-column flex-md-row justify-content-evenly mb-4 px-2">
					<div class="w-100 me-md-3">
						<div class="form-floating">
							<input type="text" class="form-control" id="tbFormAEmergencyContact" name="tbFormAEmergencyContact" autocomplete="off" data-control="textbox" data-change="hotWorkOnChange" placeholder=" " />
							<label for="tbFormAEmergencyContact">Emergency Contact</label>
						</div>
					</div>
				</div>

				<div class="bg-light p-2 mb-3 border-top border-bottom border-secondary">
					<h6 class="mb-0">HOT WORK CHECKLIST</h6>
				</div>
				<div class="px-2 mb-4">
					<div class="d-flex flex-row align-items-md-center">
						<div class="mt-1 mt-md-0">
							<input type="checkbox" class="form-check-input fc-check-input" id="chkFormACheckList1" name="chkFormACheckList1" data-control="checkbox" data-change="hotWorkOnChange" />
						</div>
						<div class="ms-3">
							<label class="form-label" for="chkFormACheckList1" style="margin-top: 4px;">
								Communication link has been established with Operations control room
							</label>
						</div>
					</div>
					<div class="d-flex flex-row align-items-md-center">
						<div class="mt-1 mt-md-0">
							<input type="checkbox" class="form-check-input fc-check-input" id="chkFormACheckList2" name="chkFormACheckList2" data-control="checkbox" data-change="hotWorkOnChange" />
						</div>
						<div class="ms-3">
							<label class="form-label" for="chkFormACheckList2" style="margin-top: 4px;">
								Calibrated gas tester to be used by AGT
							</label>
						</div>
					</div>
					<div class="d-flex flex-row align-items-md-center">
						<div class="mt-1 mt-md-0">
							<input type="checkbox" class="form-check-input fc-check-input" id="chkFormACheckList3" name="chkFormACheckList3" data-control="checkbox" data-change="hotWorkOnChange" />
						</div>
						<div class="ms-3">
							<label class="form-label" for="chkFormACheckList3" style="margin-top: 4px;">
								The working area is defined with barriers or signs to prevent un-authorized entry
							</label>
						</div>
					</div>
					<div class="d-flex flex-row align-items-md-center">
						<div class="mt-1 mt-md-0">
							<input type="checkbox" class="form-check-input fc-check-input" id="chkFormACheckList4" name="chkFormACheckList4" data-control="checkbox" data-change="hotWorkOnChange" />
						</div>
						<div class="ms-3">
							<label class="form-label" for="chkFormACheckList4" style="margin-top: 4px;">
								Designated fire watch is assigned and understands their role
							</label>
						</div>
					</div>
					<div class="d-flex flex-row align-items-md-center">
						<div class="mt-1 mt-md-0">
							<input type="checkbox" class="form-check-input fc-check-input" id="chkFormACheckList5" name="chkFormACheckList5" data-control="checkbox" data-change="hotWorkOnChange" />
						</div>
						<div class="ms-3">
							<label class="form-label" for="chkFormACheckList5" style="margin-top: 4px;">
								Area within 15 meters of ignition sources are free of flammable materials or such materials are covered with fire
								retardant material
							</label>
						</div>
					</div>
					<div class="d-flex flex-row align-items-md-center">
						<div class="mt-1 mt-md-0">
							<input type="checkbox" class="form-check-input fc-check-input" id="chkFormACheckList6" name="chkFormACheckList6" data-control="checkbox" data-change="hotWorkOnChange" />
						</div>
						<div class="ms-3">
							<label class="form-label" for="chkFormACheckList6" style="margin-top: 4px;">
								Sewer and drain systems and other low lying areas are protected against sparks within 15 meters
							</label>
						</div>
					</div>
					<div class="d-flex flex-row align-items-md-center">
						<div class="mt-1 mt-md-0">
							<input type="checkbox" class="form-check-input fc-check-input" id="chkFormACheckList7" name="chkFormACheckList7" data-control="checkbox" data-change="hotWorkOnChange" />
						</div>
						<div class="ms-3">
							<label class="form-label" for="chkFormACheckList7" style="margin-top: 4px;">
								Fire fighting materials are present and ready for use
							</label>
						</div>
					</div>
				</div>

				<div class="bg-light p-2 mb-3 border-top border-bottom border-secondary">
					<h6 class="mb-0">HOT WORK IGNITION SOURCES (mark the applicable sources for the work performed)</h6>
				</div>
				<div class="px-2 mb-4 d-flex flex-column flex-md-row">
					<div class="d-flex flex-md-row align-items-center ignition-source">
						<div>
							<input type="checkbox" class="form-check-input fc-check-input" id="chkFormAIgnitionSource1" name="chkFormAIgnitionSource1" data-control="checkbox" data-change="hotWorkOnChange" />
						</div>
						<div class="ms-3">
							<label class="form-label" for="chkFormAIgnitionSource1" style="margin-top: 4px;">
								Welding
							</label>
						</div>
					</div>
					<div class="d-flex flex-row align-items-center ignition-source">
						<div>
							<input type="checkbox" class="form-check-input fc-check-input" id="chkFormAIgnitionSource2" name="chkFormAIgnitionSource2" data-control="checkbox" data-change="hotWorkOnChange" />
						</div>
						<div class="ms-3">
							<label class="form-label" for="chkFormAIgnitionSource2" style="margin-top: 4px;">
								Burning
							</label>
						</div>
					</div>
					<div class="d-flex flex-row align-items-center ignition-source">
						<div>
							<input type="checkbox" class="form-check-input fc-check-input" id="chkFormAIgnitionSource3" name="chkFormAIgnitionSource3" data-control="checkbox" data-change="hotWorkOnChange" />
						</div>
						<div class="ms-3">
							<label class="form-label" for="chkFormAIgnitionSource3" style="margin-top: 4px;">
								Gas Cutting
							</label>
						</div>
					</div>
					<div class="d-flex flex-row align-items-center ignition-source">
						<div>
							<input type="checkbox" class="form-check-input fc-check-input" id="chkFormAIgnitionSource4" name="chkFormAIgnitionSource4" data-control="checkbox" data-change="hotWorkOnChange" />
						</div>
						<div class="ms-3">
							<label class="form-label" for="chkFormAIgnitionSource4" style="margin-top: 4px;">
								Grinding
							</label>
						</div>
					</div>
					<div class="d-flex flex-row align-items-center ignition-source">
						<div>
							<input type="checkbox" class="form-check-input fc-check-input" id="chkFormAIgnitionSource5" name="chkFormAIgnitionSource5" data-control="checkbox" data-change="onIgnitionSourceCheckBoxChange" />
						</div>
						<div class="ms-3">
							<div class="d-flex flex-row align-items-center">
								<label class="form-label" for="chkFormAIgnitionSource5" style="margin-top: 4px;">
									Other
								</label>
								<div class="ms-5 ms-md-3">
									<input type="text" class="form-control" id="tbFormAIgnitionSource5" name="tbFormAIgnitionSource5" autocomplete="off" data-control="textbox" data-change="hotWorkOnChange" disabled />
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="bg-light p-2 mb-3 border-top border-bottom border-secondary">
					<h6 class="mb-0">GAS TEST PERFORMED BY (AGT name and signature)</h6>
				</div>
				<div class="px-2 mb-4">
					<textarea class="form-control" id="tbFormAGasTestBy" name="tbFormAGasTestBy" data-control="textarea" rows="2" data-change="hotWorkOnChange"></textarea>
				</div>

				<div class="bg-light p-2 mb-3 border-top border-bottom border-secondary">
					<h6 class="mb-0">INITIAL LEL READING by AGT: Hot Work not to commence unless LEL reading is 0% (&lt; 1% considered negligible and OK)</h6>
				</div>
				<div class="px-2 mb-4">
					<div class="d-flex flex-column flex-md-row justify-content-evenly">
						<div class="w-100 me-md-3 mt-3 mt-md-0">
							<div class="form-floating">
								<input type="text" class="form-control" id="dtmFormA1" name="dtmFormA1" autocomplete="off" data-control="datetime" data-change="hotWorkOnChange" placeholder=" " />
								<label for="dtmFormA1">Date and Time</label>
							</div>
						</div>
						<div class="w-100 ms-md-3 mt-3 mt-md-0">
							<div class="form-floating">
								<input type="text" class="form-control" id="tbFormALelReading" name="tbFormALelReading" autocomplete="off" data-control="textbox" data-change="hotWorkOnChange" placeholder=" " />
								<label for="tbFormALelReading">Initial LEL % reading</label>
							</div>
						</div>
					</div>
					<div class="my-2">
						If non continuous testing is done specify testing frequency required and record results below:
					</div>
					<div class="d-flex flex-row align-items-center">
						<label class="form-label">Enter required frequency</label>
						<div class="ms-3">
							<input type="text" class="form-control" id="tbLELFrequency" name="tbLELFrequency" autocomplete="off" data-control="textbox" data-change="hotWorkOnChange" />
						</div>
					</div>
					<div class="mt-3">
						<table id="tblLEL" class="table table-striped display" style="width: 100%;">
							<thead>
								<tr>
									<th scope="col">Time of reading</th>
									<th scope="col" class="text-center" style="width: 110px;">LEL reading</th>
									<th scope="col" style="width: 50px;">&nbsp;</th>
								</tr>
							</thead>
						</table>

						<div class="d-flex flex-row justify-content-end mt-3">
							<button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#dlgLelReading"><span class="mx-3">Add reading</span></button>
						</div>
					</div>
				</div>

				<div class="bg-light p-2 mb-3 border-top border-bottom border-secondary">
					<h6 class="mb-0">Other Atmospheric Testing results if required: enter any potentially toxic gases to be monitored below</h6>
				</div>
				<div class="px-2 mb-4">
					<div class="mt-3">
						<table id="tblAtmos" class="table table-striped display" style="width: 100%;">
							<thead>
								<tr>
									<th scope="col">Time of reading</th>
									<th scope="col" class="text-center" style="width: 110px;">O<sub>2</sub> reading</th>
									<th scope="col" style="width: 50px;">&nbsp;</th>
								</tr>
							</thead>
						</table>
						<div class="d-flex flex-row justify-content-end mt-3">
							<button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#dlgAtmos"><span class="mx-3">Add reading</span></button>
						</div>
					</div>
				</div>

				<div class="bg-light p-2 mb-3 border-top border-bottom border-secondary">
					<h6 class="mb-0">VALIDITY OF THE HOT WORK PERMIT</h6>
				</div>
				<div class="px-2 mb-4">
					<div class="mb-3">
						I certify that I have reviewed the proposed work and I am satisfied that the workers
						understand the hazards and that preventive measures are in place with adequate supervision to proceed.
					</div>
					<div class="mb-3">
						<div class="mb-2">
							Hot Work Permit is allowed between
						</div>
						<div class="d-flex flex-column flex-md-row justify-content-evenly mb-3">
							<div class="w-100 me-0 me-md-3 mb-3 mb-md-0">
								<div class="form-floating">
									<input type="text" class="form-control" id="tmpFormA-TimeAllowedFrom" name="tmpFormA-TimeAllowedFrom" autocomplete="off" data-control="time" data-change="hotWorkOnChange" placeholder=" " />
									<label for="tmpFormA-TimeAllowedFrom">From</label>
								</div>
							</div><div class="w-100 ms-0 ms-md-3">
								<div class="form-floating">
									<input type="text" class="form-control" id="tmpFormA-TimeAllowedTo" name="tmpFormA-TimeAllowedTo" autocomplete="off" data-control="time" data-change="hotWorkOnChange" placeholder=" " />
									<label for="tmpFormA-TimeAllowedTo">To</label>
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="bg-light p-2 mb-3 border-top border-bottom border-secondary">
					<h6 class="mb-0">Hot Work Certificate is Withdrawn</h6>
				</div>
				<div class="px-2">
					<div class="d-flex flex-row align-items-center">
						<div class="me-5">
							<div class="form-check form-switch fc-switch">
								<input type="checkbox" role="switch" class="form-check-input" id="swHotworkWithdrawn" name="swHotworkWithdrawn" data-control="switch" data-change="onChangeWithdrawnFormA" />
							</div>
						</div>
						<label class="form-label me-3" for="tbWithdrawnReason">Reason</label>
						<div class="flex-grow-1">
							<input type="text" class="form-control" id="tbWithdrawnReason" name="tbWithdrawnReason" autocomplete="off" data-control="textbox" data-change="hotWorkOnChange" disabled />
						</div>
					</div>
				</div>

			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
				<button type="button" class="btn btn-sm btn-primary" id="btnSaveFormA" data-bs-dismiss="modal">Save changes</button>
			</div>
		</div>
	</div>
</div>

<!-- Modal: ADD LEL READING -->
<div class="modal fade" id="dlgLelReading" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="dlgLelReadingLabel" aria-hidden="true">
	<div class="modal-dialog modal-sm modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header bg-warning-soft">
				<h6 class="modal-title w-100" id="dlgLelReadingLabel">Add LEL reading</h6>
				<button type="button" class="btn btn-sm btn-clear" data-bs-dismiss="modal" aria-label="Close"><i class="fa-regular fa-close fa-xl"></i></button>
			</div>
			<div class="modal-body">
				<div>
					<div class="mb-3">
						<div class="form-floating">
							<input type="text" class="form-control" id="dtmReadTime" name="dtmReadTime" autocomplete="off" data-control="time" data-change="hotWorkOnChange" placeholder=" " />
							<label for="dtmReadTime">Time of reading</label>
						</div>
					</div>
					<div>
						<div class="form-floating">
							<input type="text" class="form-control" id="tbReadValue" name="tbReadValue" autocomplete="off" data-control="textbox" data-change="hotWorkOnChange" placeholder=" " />
							<label for="tbReadValue">LEL reading</label>
						</div>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-sm btn-secondary" data-bs-toggle="modal" data-bs-target="#dlgFormA">Close</button>
				<button type="button" class="btn btn-sm btn-primary btn-add-reading" data-bs-toggle="modal" data-bs-target="#dlgFormA">Add</button>
			</div>
		</div>
	</div>
</div>

<!-- Modal: ADD O2 LEVEL -->
<div class="modal fade" id="dlgAtmos" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="dlgAtmosLabel" aria-hidden="true">
	<div class="modal-dialog modal-sm modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header bg-warning-soft">
				<h6 class="modal-title w-100" id="dlgAtmosLabel">Add O<sub>2</sub> reading</h6>
				<button type="button" class="btn btn-sm btn-clear" data-bs-dismiss="modal" aria-label="Close"><i class="fa-regular fa-close fa-xl"></i></button>
			</div>
			<div class="modal-body">
				<div>
					<div class="mb-3">
						<div class="form-floating">
							<input type="text" class="form-control" id="dtmAtmosReadTime" name="dtmAtmosReadTime" autocomplete="off" data-control="time" data-change="hotWorkOnChange" placeholder=" " />
							<label for="dtmAtmosReadTime">Time of reading</label>
						</div>
					</div>
					<div>
						<div class="form-floating">
							<input type="text" class="form-control" id="tbAtmosReadValue" name="tbAtmosReadValue" autocomplete="off" data-control="textbox" data-change="hotWorkOnChange" placeholder=" " />
							<label for="tbAtmosReadValue">O&lt;sub&gt;2&lt;/sub&gt; reading</label>
						</div>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-sm btn-secondary" data-bs-toggle="modal" data-bs-target="#dlgFormA">Close</button>
				<button type="button" class="btn btn-sm btn-primary btn-add-o2" data-bs-toggle="modal" data-bs-target="#dlgFormA">Add</button>
			</div>
		</div>
	</div>
</div>
<!-- ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////// -->
