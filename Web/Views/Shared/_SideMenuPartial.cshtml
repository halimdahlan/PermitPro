@using Microsoft.AspNetCore.Identity
@using PermitPro.Core.Data

@inject SignInManager<UserInfo> _signInManager
@inject UserManager<UserInfo> _userManager
@inject ApplicationDbContext _dbContext
@inject ISystemConfigurationService _systemConfigurationService

@{
	var currentRoute = ViewContext.RouteData.Values["controller"] as string;
	var companyId = ViewContext.RouteData.Values["company"] as string;
	var currentUser = await _userManager.GetUserAsync(User);

	var navDashboard = currentRoute?.ToLower() == "dashboard" ? "active" : "";
	var navSitemap = currentRoute?.ToLower() == "sitemap" ? "active" : "";
	var navPermits = currentRoute?.ToLower() == "permits" ? "active" : "";
	var navContractors = currentRoute?.ToLower() == "contractors" ? "active" : "";
	var navReports = currentRoute?.ToLower() == "reports" ? "active" : "";
	var navUsers = currentRoute?.ToLower() == "users" ? "active" : "";
	var navSites = currentRoute?.ToLower() == "sites" ? "active" : "";
	var navWorkflow = currentRoute?.ToLower() == "workflow" ? "active" : "";
	var navNotifications = currentRoute?.ToLower() == "notifications" ? "active" : "";
	var currentAction = ViewContext.RouteData.Values["action"] as string;
	var navSettings = currentRoute?.ToLower() == "settings" && currentAction?.ToLower() != "about" ? "active" : "";
	var navAbout = currentRoute?.ToLower() == "settings" && currentAction?.ToLower() == "about" ? "active" : "";
	var navFormControls  = currentRoute?.ToLower() == "tenantformcontrols"  ? "active" : "";
	var navFormTemplates = currentRoute?.ToLower() == "tenantformtemplates" ? "active" : "";
	var navCertTemplates = "";

	if (TempData["CurrentPage"]?.ToString()?.ToLower().Contains("certificate", StringComparison.OrdinalIgnoreCase) == true)
	{
		navCertTemplates = "active";
		navFormTemplates = "";
	}
	
	var isTemplatesActive = navFormControls == "active" || navFormTemplates == "active" || navCertTemplates == "active";
	var templatesShow    = isTemplatesActive ? " show" : "";
	var navGeneral = currentRoute?.ToLower() == "dashboard" ? "active" : "";
	var navRecycleBin = currentRoute?.ToLower() == "recyclebin" ? " active" : "";
	var showMenu = "";
	var navPermitsMain = "";
	var arrowClass = "fa-chevron-down";
	var arrowClass2 = "fa-chevron-down";

	if (companyId == Guid.Empty.ToString())
	{
		var company = _dbContext.Companies.FirstOrDefault(x => x.IsActive == true);
		companyId = company?.Id.ToString();
	}

	if (navSitemap == "active" || navPermits == "active")
	{
		showMenu = " show";
		navPermitsMain = "active-light active";
		arrowClass = "fa-chevron-up";
	}

	if (isTemplatesActive)
	{
		arrowClass2 = "fa-chevron-up";
	}

	var isSuperUser = User.IsInRole("Super User");
	var isPortalAdmin = User.IsInRole("Portal Admin");
	var isContractor = User.IsInRole("Permit Holder / Contractor");
}

<ul class="navbar-nav mb-4">
	@if (isContractor)
	{
		<li class="nav-item">
			<a href="/@companyId/permits" class="nav-link @navPermits">
				<i class="fa-solid fa-list-ul fa-fw me-3"></i>Permits
			</a>
		</li>
	}
	else
	{
		<li class="nav-item">
			<a href="/@companyId/dashboard" class="nav-link @navDashboard" href="#">
				<i class="fa-regular fa-chart-line fa-fw me-3"></i>Dashboard
			</a>
		</li>
		<li class="nav-item">
			<a href="#" id="permitsDropdown" class="d-flex no-loading nav-link @navPermitsMain">
				<i class="fa-solid fa-list-ul fa-fw me-3 mt-1"></i>Permits
				<i class="fa-solid fa-fw ms-auto @arrowClass"></i>
			</a>
			<div id="permitSubmenu" class="ps-3 collapse @showMenu">
				<ul class="navbar-nav">
					<li class="nav-item">
						<a href="/@companyId/permits" class="nav-link @navPermits">
							<i class="fa-solid fa-list-ul fa-fw me-3"></i>All Permits
						</a>
					</li>
					<li class="nav-item">
						<a href="/@companyId/sitemap" class="nav-link @navSitemap">
							<i class="fa-solid fa-map-location-dot fa-fw me-3"></i>Site Map
						</a>
					</li>
				</ul>
			</div>
		</li>
	}
	
	@if (isPortalAdmin || isSuperUser)
	{
		<li class="nav-item">
			<a href="/@companyId/contractors" class="nav-link @navContractors">
				<i class="fa-regular fa-user-helmet-safety fa-fw me-3"></i>Contractors
			</a>
		</li>
	}

	@if (!isContractor)
	{
		<li class="nav-item">
			<a href="/@companyId/reports" class="nav-link @navReports">
				<i class="fa-sharp fa-regular fa-file-invoice fa-fw me-3"></i>Reports
			</a>
		</li>
	}
	
	<li class="nav-item">
		<a href="/@companyId/notifications" class="nav-link @navNotifications">
			<i class="fa-sharp fa-solid fa-envelope-open-text fa-fw me-3"></i>Notifications
		</a>
	</li>
</ul>

@if (isPortalAdmin || isSuperUser)
{
	<h5 class="sidebar-heading text-uppercase text-white" style="opacity: 0.3;">Settings</h5>
	<ul class="navbar-nav mt-2 mb-4">
		<li class="nav-item">
			<a href="/@companyId/sites" class="nav-link @navSites">
				<i class="fa-sharp fa-regular fa-map-location-dot fa-fw me-3"></i>Locations
			</a>
		</li>
		<li class="nav-item">
			<a href="/@companyId/users" class="nav-link @navUsers">
				<i class="fa-solid fa-user-gear fa-fw me-3"></i>Users
			</a>
		</li>
		<li class="nav-item">
			<a href="/@companyId/workflow" class="nav-link @navWorkflow">
				<i class="fa-regular fa-people-carry-box fa-fw me-3"></i>Workflows
			</a>
		</li>
	</ul>
	<h5 class="sidebar-heading text-uppercase text-white" style="opacity: 0.3;">Admin</h5>
	<ul class="navbar-nav mt-2">
		<li class="nav-item">
			<a href="/@companyId/recyclebin" class="nav-link @navRecycleBin">
				<i class="fa-solid fa-trash-can-arrow-up fa-fw me-3"></i>Recycle Bin
			</a>
		</li>
		@if (isSuperUser)
		{
			<li class="nav-item">
				<a href="/@companyId/settings" class="nav-link @navSettings">
					<i class="fa-solid fa-cog fa-fw me-3"></i>System Settings
				</a>
			</li>

			<!---->
			<li class="nav-item">
				<a href="#" id="templatesDropdown" class="d-flex no-loading nav-link @(isTemplatesActive ? "active-light active" : "")">
					<i class="fa-solid fa-list-ul fa-fw me-3 mt-1"></i>Templates
					<i class="fa-solid fa-fw ms-auto @arrowClass2"></i>
				</a>
				<div id="templateSubmenu" class="ps-3 collapse @templatesShow">
					<ul class="navbar-nav">
						<li class="nav-item">
							<a href="/@companyId/formcontrols" class="nav-link @navFormControls">
								<i class="fa-solid fa-sliders fa-fw me-3"></i>Form Controls
							</a>
						</li>
						<li class="nav-item">
							<a href="/@companyId/formtemplates" class="nav-link @navFormTemplates">
								<i class="fa-solid fa-table-columns fa-fw me-3"></i>Permit Forms
							</a>
						</li>
						<li class="nav-item">
							<a href="/@companyId/certificatetemplates" class="nav-link @navCertTemplates">
								<i class="fa-solid fa-certificate fa-fw me-3"></i>Certificates
							</a>
						</li>
					</ul>
				</div>
			</li>
			
			
		}
	</ul>
}