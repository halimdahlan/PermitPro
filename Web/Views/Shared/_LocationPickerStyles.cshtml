@* Styles for the Treeselect "Locations" picker. Render inside @section CustomCss. *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/treeselectjs@1.0.2/dist/treeselectjs.css" />
<style>
	/* Match Bootstrap's form controls. */
	:root {
		--treeselectjs-border-color: var(--bs-border-color);
		--treeselectjs-border-focus: #2c7be5;
		--treeselectjs-checkbox-checked-bg: var(--bs-primary);
		--treeselectjs-tag-bg: var(--bs-secondary-bg);
	}
	[data-bs-theme="dark"] {
		--treeselectjs-bg: var(--bs-body-bg);
		--treeselectjs-border-color: var(--bs-border-color);
		--treeselectjs-border-focus: var(--accent);
		--treeselectjs-tag-bg: var(--surface-2);
		--treeselectjs-tag-bg-hover: var(--border-strong);
		--treeselectjs-icon: var(--muted-light);
		--treeselectjs-icon-hover: var(--text);
		--treeselectjs-item-counter: var(--muted);
		--treeselectjs-item-focus-bg: var(--surface-2);
		--treeselectjs-item-selected-bg: var(--accent-light);
		--treeselectjs-item-disabled-text: var(--muted-light);
		--treeselectjs-checkbox-bg: var(--bs-body-bg);
		--treeselectjs-checkbox-border-color: var(--border-strong);
	}
	[data-bs-theme="dark"] .treeselect-list {
		background-color: var(--card);
	}

	.treeselect, .treeselect-list {
		font-family: 'Poppins', sans-serif;
		font-size: 14px;
	}

	.treeselect-input {
		min-height: calc(1.5em + .9rem + 2px);
		border-radius: var(--bs-border-radius);
	}
</style>
