
@{
	ViewData["Title"] = "Reports";
	ViewData["SubTitle"] = "Summary";

	var companyId = ViewContext.RouteData.Values["company"] as string;
}

@model ReportsViewModel

<div class="report-filters">
	<div class="d-flex flex-row align-items-center mb-2">
		<div class="me-3 label-width">
			<div class="form-check mb-0">
				<input class="form-check-input" type="radio" name="filterOption" id="option1" value="monthYear" checked />
				<label class="form-check-label" for="option1">Month/Year</label>
			</div>
		</div>
		<div class="report-filter-sm">
			<select id="ddlMonth" asp-items="Model.Months" autocomplete="off" aria-label="Month"></select>
		</div>
		<div class="ms-2 report-filter-sm">
			<select id="ddlYear" asp-items="Model.Years" autocomplete="off" aria-label="Year"></select>
		</div>
	</div>

	<div class="d-flex flex-row align-items-center mb-2">
		<div class="me-3 label-width">
			<div class="form-check mb-0">
				<input class="form-check-input" type="radio" name="filterOption" id="option2" value="dateRange" />
				<label class="form-check-label" for="option2">Date range</label>
			</div>
		</div>
		<div class="report-filter-md">
			<input id="dateRange" type="text" class="form-control" placeholder="dd/mm/yyyy – dd/mm/yyyy" aria-label="Date range" disabled />
		</div>
		<div class="ms-3">
			<a href="javascript:;" class="clear-range no-loading">Clear</a>
		</div>
	</div>

	<div class="d-flex flex-row align-items-center mb-2">
		<div class="me-3 label-width">Location</div>
		<div class="report-filter">
			<div id="ddtLocation"></div>
		</div>
	</div>

	<div class="d-flex flex-row align-items-center mb-2">
		<label for="ddlPermitHolder" class="me-3 label-width">Permit holder</label>
		<div class="report-filter">
			<select id="ddlPermitHolder" asp-items="Model.PermitHolders" autocomplete="off"></select>
		</div>
	</div>

	<div class="d-flex flex-row align-items-center mb-2">
		<label for="ddlCertificate" class="me-3 label-width">Certificate type</label>
		<div class="report-filter">
			<select id="ddlCertificate" asp-items="Model.Certificates" autocomplete="off"></select>
		</div>
	</div>

	<div class="d-flex flex-row align-items-center mb-4">
		<label for="ddlPermitStatus" class="me-3 label-width">Permit status</label>
		<div class="report-filter">
			<select id="ddlPermitStatus" asp-items="Model.PermitStatuses" autocomplete="off"></select>
		</div>
	</div>
</div>

<div class="d-flex flex-row align-items-center">
	<button class="btn btn-sm btn-primary view-report" type="button"><span class="mx-3">View report</span></button>
	<div class="ms-3">
		<a href="javascript:;" class="clear-filter no-loading">Clear filter</a>
	</div>
</div>

<hr />

<!-- Inline loading state for the stats area -->
<div id="reportLoading" class="text-center py-5" style="display:none">
	<i class="fa-solid fa-loader fa-spin text-secondary" style="font-size:2rem"></i>
	<p class="text-secondary mt-2 mb-0 small">Loading statistics…</p>
</div>

<!-- KPI Summary Cards -->
<div id="kpiSection" class="mb-4" style="display:none">
	<div class="row g-3">
		<div class="col">
			<div class="card border-0 shadow-sm text-center kpi-card">
				<div class="card-body py-3">
					<div class="kpi-value text-primary" id="kpiTotal">—</div>
					<div class="kpi-label">Total Permits</div>
				</div>
			</div>
		</div>
		<div class="col">
			<div class="card border-0 shadow-sm text-center kpi-card">
				<div class="card-body py-3">
					<div class="kpi-value" style="color:#f6c343" id="kpiPending">—</div>
					<div class="kpi-label">Pending</div>
				</div>
			</div>
		</div>
		<div class="col">
			<div class="card border-0 shadow-sm text-center kpi-card">
				<div class="card-body py-3">
					<div class="kpi-value text-success" id="kpiApproved">—</div>
					<div class="kpi-label">Approved</div>
				</div>
			</div>
		</div>
		<div class="col">
			<div class="card border-0 shadow-sm text-center kpi-card">
				<div class="card-body py-3">
					<div class="kpi-value text-secondary" id="kpiClosed">—</div>
					<div class="kpi-label">Closed</div>
				</div>
			</div>
		</div>
		<div class="col">
			<div class="card border-0 shadow-sm text-center kpi-card" id="kpiOverdueCard">
				<div class="card-body py-3">
					<div class="kpi-value text-danger" id="kpiOverdue">—</div>
					<div class="kpi-label">Overdue</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Charts Row -->
<div id="chartsSection" class="mb-4" style="display:none">
	<div class="row g-3">
		<div class="col-md-3">
			<div class="card border-0 shadow-sm h-100">
				<div class="card-body">
					<div class="chart-section-title">Status Distribution</div>
					<div class="chart-wrap">
						<canvas id="statusChart"></canvas>
					</div>
				</div>
			</div>
		</div>
		<div class="col-md-6">
			<div class="card border-0 shadow-sm h-100">
				<div class="card-body">
					<div class="chart-section-title">Monthly Trend <span class="fw-normal text-secondary">(last 12 months)</span></div>
					<div class="chart-wrap">
						<canvas id="monthlyChart"></canvas>
					</div>
				</div>
			</div>
		</div>
		<div class="col-md-3">
			<div class="card border-0 shadow-sm h-100">
				<div class="card-body">
					<div class="chart-section-title">Top Locations</div>
					<div class="chart-wrap">
						<canvas id="locationChart"></canvas>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Report Tabs -->
<ul class="nav nav-tabs mt-3 mb-0" id="reportTabs" role="tablist">
	<li class="nav-item" role="presentation">
		<button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-permits" type="button" role="tab">All Permits</button>
	</li>
	<li class="nav-item" role="presentation">
		<button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-overdue" type="button" role="tab">
			Overdue <span class="badge bg-danger ms-1 d-none" id="badgeOverdue"></span>
		</button>
	</li>
	<li class="nav-item" role="presentation">
		<button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-by-holder" type="button" role="tab">By Holder</button>
	</li>
	<li class="nav-item" role="presentation">
		<button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-by-location" type="button" role="tab">By Location</button>
	</li>
</ul>
<div class="tab-content border border-top-0 rounded-bottom" id="reportTabContent">

	<div class="tab-pane fade show active p-3" id="tab-permits" role="tabpanel">
		<div class="data-grid">
			<div class="grid-error alert alert-danger d-none" role="alert"></div>
			<table id="tblReport" class="table table-sm table-hover align-middle w-100">
				<thead>
					<tr>
						<th>Permit Holder</th>
						<th>Location</th>
						<th>Permit No.</th>
						<th>Status</th>
						<th>Start Date</th>
						<th>End Date</th>
						<th>Duration</th>
						<th>Certificates</th>
						<th>Submitted On</th>
					</tr>
				</thead>
			</table>
		</div>
	</div>

	<!-- Overdue permits -->
	<div class="tab-pane fade p-3" id="tab-overdue" role="tabpanel">
		<div id="overdueContainer">
			<p class="text-secondary text-center py-4 mb-0 small">Apply a filter and click <strong>View report</strong> to see overdue permits.</p>
		</div>
	</div>

	<!-- By permit holder -->
	<div class="tab-pane fade p-3" id="tab-by-holder" role="tabpanel">
		<div id="holderContainer">
			<p class="text-secondary text-center py-4 mb-0 small">Apply a filter and click <strong>View report</strong> to see a breakdown by permit holder.</p>
		</div>
	</div>

	<!-- By location -->
	<div class="tab-pane fade p-3" id="tab-by-location" role="tabpanel">
		<div id="locationContainer">
			<p class="text-secondary text-center py-4 mb-0 small">Apply a filter and click <strong>View report</strong> to see a breakdown by location.</p>
		</div>
	</div>

</div>
@Html.AntiForgeryToken()

@section CustomCss {
	<partial name="_DataGridStyles" />
	<partial name="_LocationPickerStyles" />
	<link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.2.6/css/buttons.bootstrap5.min.css" />
	<link rel="stylesheet" href="https://cdn.datatables.net/rowgroup/1.6.0/css/rowGroup.bootstrap5.min.css" />
	<partial name="_FlatpickrStyles" />
	<link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
}

@section Scripts {
	<partial name="_DataGridScripts" />
	<partial name="_LocationPickerScripts" />
	@* Excel export (uses the JSZip loaded by _Layout) and row grouping for the All Permits grid. *@
	<script src="https://cdn.datatables.net/buttons/3.2.6/js/dataTables.buttons.min.js"></script>
	<script src="https://cdn.datatables.net/buttons/3.2.6/js/buttons.bootstrap5.min.js"></script>
	<script src="https://cdn.datatables.net/buttons/3.2.6/js/buttons.html5.min.js"></script>
	<script src="https://cdn.datatables.net/rowgroup/1.6.0/js/dataTables.rowGroup.min.js"></script>
	<script src="https://cdn.datatables.net/rowgroup/1.6.0/js/rowGroup.bootstrap5.min.js"></script>
	<partial name="_FlatpickrScripts" />
	<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
	<script>
		var companyId = '@companyId';
		var useDateRange = false;
		var statusChart = null, monthlyChart = null, locationChart = null;
		var _overduePermits = [];
		const OVERDUE_PAGE_SIZE = 20;

		const chartColors = {
			approved: '#00d97e',
			pending:  '#f6c343',
			other:    '#b2c1d6',
			blue:     '#2c7be5',
			statusPalette: ['#b2c1d6', '#f6c343', '#00d97e', '#e63757', '#fd7e14', '#6f42c1', '#6e84a3'],
		};

		const chartFont = { family: "'Poppins', sans-serif", size: 11 };

		// Server values (names, locations, ...) are inserted as text, never as HTML.
		const esc = (value) => DataGrid.escapeHtml(value);

		const renderOverduePage = (page) => {
			if (!_overduePermits || _overduePermits.length === 0) {
				$('#overdueContainer').html('<p class="text-secondary text-center py-4 mb-0 small">No overdue permits found for the selected filters.</p>');
				return;
			}
			const total = _overduePermits.length;
			const totalPages = Math.ceil(total / OVERDUE_PAGE_SIZE);
			page = Math.max(1, Math.min(page, totalPages));
			const slice = _overduePermits.slice((page - 1) * OVERDUE_PAGE_SIZE, page * OVERDUE_PAGE_SIZE);
			const rows = slice.map(p => `
				<tr>
					<td><a href="/${companyId}/permits/edit/${encodeURIComponent(p.id)}">${esc(p.permitNo)}</a></td>
					<td>${esc(p.holderName)}</td>
					<td>${esc(p.location)}</td>
					<td class="text-danger">${esc(p.endDate)}</td>
					<td class="text-center">${p.daysOverdue} day${p.daysOverdue !== 1 ? 's' : ''}</td>
					<td><span class="badge bg-warning text-dark">${esc(p.status)}</span></td>
				</tr>`).join('');
			let pagination = '';
			if (totalPages > 1) {
				const from = (page - 1) * OVERDUE_PAGE_SIZE + 1;
				const to = Math.min(page * OVERDUE_PAGE_SIZE, total);
				let items = `<li class="page-item${page === 1 ? ' disabled' : ''}"><a class="page-link overdue-page" data-page="${page - 1}" href="#">&laquo;</a></li>`;
				for (let i = 1; i <= totalPages; i++)
					items += `<li class="page-item${i === page ? ' active' : ''}"><a class="page-link overdue-page" data-page="${i}" href="#">${i}</a></li>`;
				items += `<li class="page-item${page === totalPages ? ' disabled' : ''}"><a class="page-link overdue-page" data-page="${page + 1}" href="#">&raquo;</a></li>`;
				pagination = `<div class="d-flex justify-content-between align-items-center mt-2 px-1">
					<small class="text-secondary">Showing ${from}–${to} of ${total} records</small>
					<nav><ul class="pagination pagination-sm mb-0">${items}</ul></nav>
				</div>`;
			}
			// .data-grid + labelTable: each overdue permit as a card on phones (datagrid.css).
			$('#overdueContainer').html(`<div class="data-grid table-responsive"><table class="table table-sm table-hover align-middle report-table">
				<thead class="table-light"><tr>
					<th>Permit No.</th><th>Permit Holder</th><th>Location</th>
					<th>End Date</th><th class="text-center">Days Overdue</th><th>Status</th>
				</tr></thead><tbody>${rows}</tbody>
			</table></div>${pagination}`);
			DataGrid.labelTable($('#overdueContainer table')[0]);
		};

		const renderHolderTable = (holders) => {
			if (!holders || holders.length === 0)
				return '<p class="text-secondary text-center py-4 mb-0 small">No data for the selected filters.</p>';
			const rows = holders.map(h => {
				const rate = h.total > 0 ? Math.round(h.approved / h.total * 100) : 0;
				return `<tr>
					<td>${esc(h.name)}</td>
					<td class="text-center">${h.total}</td>
					<td class="text-center text-success">${h.approved}</td>
					<td class="text-center" style="color:#f6c343">${h.pending}</td>
					<td class="text-center text-secondary">${h.other}</td>
					<td class="text-center">
						<div class="d-flex align-items-center gap-2">
							<div class="progress flex-grow-1" style="height:6px">
								<div class="progress-bar bg-success" style="width:${rate}%"></div>
							</div>
							<span class="text-secondary" style="font-size:0.75rem;min-width:30px">${rate}%</span>
						</div>
					</td>
				</tr>`;
			}).join('');
			return `<div class="table-responsive"><table class="table table-sm table-hover align-middle report-table report-summary">
				<thead class="table-light"><tr>
					<th>Permit Holder</th>
					<th class="text-center">Total</th>
					<th class="text-center text-success">Approved</th>
					<th class="text-center" style="color:#f6c343">Pending</th>
					<th class="text-center text-secondary">Other</th>
					<th>Approval Rate</th>
				</tr></thead><tbody>${rows}</tbody>
			</table></div>`;
		};

		const renderLocationTable = (locations) => {
			if (!locations || locations.length === 0)
				return '<p class="text-secondary text-center py-4 mb-0 small">No data for the selected filters.</p>';
			const rows = locations.map(l => {
				const rate = l.count > 0 ? Math.round(l.approved / l.count * 100) : 0;
				return `<tr>
					<td>${esc(l.label)}</td>
					<td class="text-center">${l.count}</td>
					<td class="text-center text-success">${l.approved}</td>
					<td class="text-center" style="color:#f6c343">${l.pending}</td>
					<td class="text-center text-secondary">${l.other}</td>
					<td>
						<div class="d-flex align-items-center gap-2">
							<div class="progress flex-grow-1" style="height:6px">
								<div class="progress-bar bg-success" style="width:${rate}%"></div>
							</div>
							<span class="text-secondary" style="font-size:0.75rem;min-width:30px">${rate}%</span>
						</div>
					</td>
				</tr>`;
			}).join('');
			return `<div class="table-responsive"><table class="table table-sm table-hover align-middle report-table report-summary">
				<thead class="table-light"><tr>
					<th>Location</th>
					<th class="text-center">Total</th>
					<th class="text-center text-success">Approved</th>
					<th class="text-center" style="color:#f6c343">Pending</th>
					<th class="text-center text-secondary">Other</th>
					<th>Approval Rate</th>
				</tr></thead><tbody>${rows}</tbody>
			</table></div>`;
		};

		const loadChartData = (params) => {
			$.ajax({
				url: `/${companyId}/reports/getchartdata`,
				data: params,
				method: 'GET',
				success: (data) => {
					// KPI cards
					$('#kpiTotal').text(data.summary.total);
					$('#kpiPending').text(data.summary.pending);
					$('#kpiApproved').text(data.summary.approved);
					$('#kpiClosed').text(data.summary.closed);
					$('#kpiOverdue').text(data.summary.overdue);
					$('#kpiOverdueCard').toggleClass('kpi-card-danger', data.summary.overdue > 0);

					$('#kpiSection, #chartsSection').show();

					// Tab tables
					_overduePermits = data.overduePermits || [];
					renderOverduePage(1);
					$('#holderContainer').html(renderHolderTable(data.byHolder));
					$('#locationContainer').html(renderLocationTable(data.byLocation));

					const overdueCount = _overduePermits.length;
					$('#badgeOverdue').text(overdueCount).toggleClass('d-none', overdueCount === 0);

					// Destroy stale chart instances before re-drawing
					if (statusChart)   { statusChart.destroy();   statusChart = null; }
					if (monthlyChart)  { monthlyChart.destroy();  monthlyChart = null; }
					if (locationChart) { locationChart.destroy(); locationChart = null; }

					// ── Doughnut: status distribution ──────────────────
					statusChart = new Chart(document.getElementById('statusChart'), {
						type: 'doughnut',
						data: {
							labels: ['Draft', 'Pending', 'Approved', 'Rejected', 'Suspended', 'KIV', 'Closed'],
							datasets: [{
								data: [
									data.summary.draft, data.summary.pending, data.summary.approved,
									data.summary.rejected, data.summary.suspended, data.summary.kiv, data.summary.closed
								],
								backgroundColor: chartColors.statusPalette,
								borderWidth: 2,
								// Segment gaps in the card colour; scriptable so they follow a theme switch.
								borderColor: () => PPTheme.color('--card'),
								hoverBorderColor: () => PPTheme.color('--card'),
							}]
						},
						options: {
							responsive: true,
							maintainAspectRatio: false,
							cutout: '65%',
							plugins: {
								legend: {
									position: 'bottom',
									labels: { font: chartFont, padding: 8, boxWidth: 12 }
								}
							}
						}
					});

					// ── Stacked bar: monthly trend ──────────────────────
					monthlyChart = new Chart(document.getElementById('monthlyChart'), {
						type: 'bar',
						data: {
							labels: data.byMonth.map(m => m.label),
							datasets: [
								{ label: 'Approved / Closed', data: data.byMonth.map(m => m.approved), backgroundColor: chartColors.approved, borderRadius: 3 },
								{ label: 'Pending',           data: data.byMonth.map(m => m.pending),  backgroundColor: chartColors.pending,  borderRadius: 3 },
								{ label: 'Other',             data: data.byMonth.map(m => m.other),    backgroundColor: chartColors.other,    borderRadius: 3 },
							]
						},
						options: {
							responsive: true,
							maintainAspectRatio: false,
							plugins: {
								legend: { position: 'bottom', labels: { font: chartFont, boxWidth: 12, padding: 8 } }
							},
							scales: {
								x: { stacked: true, grid: { display: false }, ticks: { font: chartFont } },
								y: { stacked: true, ticks: { font: chartFont, precision: 0 } }
							}
						}
					});

					// ── Horizontal bar: top locations ───────────────────
					locationChart = new Chart(document.getElementById('locationChart'), {
						type: 'bar',
						data: {
							labels: data.byLocation.map(l => l.label),
							datasets: [{
								label: 'Permits',
								data: data.byLocation.map(l => l.count),
								backgroundColor: chartColors.blue,
								borderRadius: 3,
							}]
						},
						options: {
							indexAxis: 'y',
							responsive: true,
							maintainAspectRatio: false,
							plugins: { legend: { display: false } },
							scales: {
								x: { grid: { display: false }, ticks: { font: chartFont, precision: 0 } },
								y: { grid: { display: false }, ticks: { font: chartFont } }
							}
						}
					});
				},
				complete: () => { $('#reportLoading').hide(); }
			});
		};


		var tbl = null;             // All Permits grid (DataTables)
		var fpRange = null;         // Date range picker (Flatpickr)
		var locationTree = null;    // Location filter (Treeselect, single choice)
		var selectedLocationId = '';
		var filterSelects = {};     // Tom Select instances, by select id
		var reportFilter = null;    // Filter applied by "View report"; null shows every permit.
		var currentGroups = ['date']; // "Group by" levels, outermost first (GROUPS keys)

		// Column indexes in #tblReport.
		const COL = { holder: 0, location: 1, permitNo: 2, status: 3, start: 4, end: 5, duration: 6, certificates: 7, submitted: 8 };

		// "Group by" choices: data field, column to keep the groups in order, and the group header text.
		const GROUPS = {
			date:     { field: 'CreatedWhen',      col: COL.submitted, dir: 'desc', label: 'Date',          text: (v) => moment(v).format('DD MMM, YYYY') },
			holder:   { field: 'PermitHolderName', col: COL.holder,    dir: 'asc',  label: 'Permit holder', text: (v) => v },
			location: { field: 'Location',         col: COL.location,  dir: 'asc',  label: 'Location',      text: (v) => v },
			status:   { field: 'PermitStatus',     col: COL.status,    dir: 'asc',  label: 'Status',        text: (v) => v },
		};

		// Formatted date for display and Excel; raw ISO value for sorting.
		const renderReportDate = (data, type) => {
			if (type === 'display') return data ? moment(data).format('DD MMM, YYYY') : '&mdash;';
			if (type === 'export') return data ? moment(data).format('DD MMM, YYYY') : '';
			return data ?? '';
		};

		// Permits in a group across all filtered rows, not just the current page: rows matching the
		// group's value at this level and at every level above it (taken from any row of the group).
		const groupCount = (rows, level) => {
			const sample = rows.data()[0];
			const fields = currentGroups.slice(0, level + 1).map(k => GROUPS[k].field);
			return tbl.rows({ search: 'applied' }).data().toArray()
				.filter(r => fields.every(f => (r[f] ?? '') === (sample[f] ?? ''))).length;
		};

		// Group header text, e.g. "Location: Fuel Terminal" (escaped).
		const groupTitle = (group, level) => {
			const g = GROUPS[currentGroups[level]];
			return `${g.label}: ${DataGrid.escapeHtml(g.text(group))}`;
		};

		// "Group by" control shown in the grid toolbar, next to the Excel button.
		const groupByControl = () => {
			const div = document.createElement('div');
			div.className = 'd-flex align-items-center me-3 report-group-by';
			div.innerHTML =
				'<label for="ddlGroupBy" class="me-2 mb-0 text-nowrap">Group by</label>' +
				'<div class="grid-filter"><select id="ddlGroupBy" multiple autocomplete="off" placeholder="(none)">' +
				'<option value="date" selected>Submitted date</option>' +
				'<option value="holder">Permit holder</option>' +
				'<option value="location">Location</option>' +
				'<option value="status">Status</option>' +
				'</select></div>';
			return div;
		};

		// Groups nest in the order they were picked; rows are kept in group order at every level.
		const setGroups = (keys) => {
			currentGroups = (keys || []).filter(k => GROUPS[k]);

			if (currentGroups.length === 0) {
				tbl.rowGroup().disable();
				tbl.order.fixed({});
			} else {
				tbl.rowGroup().dataSrc(currentGroups.map(k => GROUPS[k].field)).enable();
				tbl.order.fixed({ pre: currentGroups.map(k => [GROUPS[k].col, GROUPS[k].dir]) });
			}

			tbl.draw();
		};

		// Reads the filter panel. Values match the fields of ReportGridModel.
		const readFilters = () => {
			const f = {
				useDateRange: useDateRange,
				month: '', year: '', start: null, end: null,
				locationId: selectedLocationId || '',
				holderId: filterSelects.ddlPermitHolder.getValue(),
				certificate: filterSelects.ddlCertificate.getValue(),
				status: filterSelects.ddlPermitStatus.getValue(),
			};

			if (useDateRange) {
				[f.start, f.end] = fpRange.selectedDates;
				f.start = f.start ?? null;
				f.end = f.end ?? f.start;
			} else {
				f.month = filterSelects.ddlMonth.getValue();
				f.year = filterSelects.ddlYear.getValue();
			}

			return f;
		};

		// Applies reportFilter to the All Permits grid (filtered in the browser; the grid loads every permit once).
		DataTable.ext.search.push((settings, searchData, index, row) => {
			if (settings.nTable.id !== 'tblReport' || !reportFilter) return true;

			const f = reportFilter;
			const created = moment(row.CreatedWhen);

			if (f.start && created.isBefore(f.start, 'day')) return false;
			if (f.end && created.isAfter(f.end, 'day')) return false;
			if (f.month && row.CreatedMonth !== f.month) return false;
			if (f.year && String(row.CreatedYear) !== f.year) return false;
			if (f.locationId && (row.LocationId || '').toLowerCase() !== f.locationId.toLowerCase()) return false;
			if (f.holderId && row.PermitHolderId !== f.holderId) return false;
			if (f.certificate && !(row.Certificates || '').split(', ').includes(f.certificate)) return false;
			if (f.status !== '' && String(row.PermitStatusEnum) !== f.status) return false;

			return true;
		});


		$(document).ready(() => {

			// ── Filter panel ─────────────────────────────────────
			['ddlMonth', 'ddlYear', 'ddlPermitHolder', 'ddlCertificate', 'ddlPermitStatus'].forEach(id => {
				filterSelects[id] = new TomSelect('#' + id, {
					allowEmptyOption: true,
					maxOptions: null,
					// Search box inside the dropdown, so the control keeps its height.
					plugins: ['dropdown_input'],
				});
			});

			fpRange = flatpickr('#dateRange', {
				mode: 'range',
				dateFormat: 'd/m/Y',
				locale: { rangeSeparator: ' – ' },
				// No disabled days: in range mode Flatpickr won't let a range cross one, so the old
				// weekend rule capped every range at a single Mon–Fri week.
			});

			fetch(`/${companyId}/sites/tree`, { headers: { 'Accept': 'application/json' } })
				.then(r => { if (!r.ok) throw new Error(r.statusText); return r.json(); })
				.then(options => {
					locationTree = new Treeselect({
						parentHtmlContainer: document.getElementById('ddtLocation'),
						options: options,
						value: null,
						isSingleSelect: true,
						showTags: false,
						placeholder: '(select)',
						emptyText: 'No locations found.',
						inputCallback: (value) => { selectedLocationId = value ?? ''; },
					});
				})
				.catch(() => {
					$('#ddtLocation').html('<div class="form-control text-danger">Could not load locations.</div>');
				});

			$('input[name="filterOption"]').change(onOptionChange);


			// ── All Permits grid ─────────────────────────────────
			tbl = DataGrid.create('#tblReport', '@Url.Action("GetReportGrid", "Reports", new { company = Model.CompanyId })', {
				pageLength: 25,
				lengthMenu: [25, 50, 100, 250],
				layout: {
					topStart: [groupByControl, 'buttons'],
				},
				language: {
					emptyTable: 'No data available at the moment.',
					zeroRecords: 'No permits match the selected filters.',
					info: 'Showing _START_ to _END_ of _TOTAL_ permits',
					infoFiltered: '(filtered from _MAX_)',
				},
				buttons: {
					dom: { button: { className: 'btn btn-sm btn-outline-success' } },
					buttons: [{
						extend: 'excelHtml5',
						text: '<i class="fa-solid fa-file-excel me-2"></i>Export to Excel',
						title: 'Permit Report',
						filename: () => 'permit-report-' + moment().format('YYYYMMDD'),
						// All filtered rows (every page), including the hidden "Submitted On" column.
						exportOptions: { columns: ':not(.no-export)', orthogonal: 'export' },
					}],
				},
				orderFixed: { pre: [GROUPS.date.col, GROUPS.date.dir] },
				rowGroup: {
					dataSrc: GROUPS.date.field,
					emptyDataGroup: '(none)',
					startRender: (rows, group, level) => groupTitle(group, level),
					// With several levels the totals stack up, so each one names its group.
					endRender: (rows, group, level) => currentGroups.length > 1
						? `Num. of permits (${groupTitle(group, level)}): ${groupCount(rows, level)}`
						: `Num. of permits: ${groupCount(rows, level)}`,
				},
				columns: [
					{ data: 'PermitHolderName', render: DataGrid.renderText },
					{ data: 'Location', render: DataGrid.renderText },
					{
						data: 'PermitNo',
						className: 'text-nowrap',
						render: (data, type, row) => type === 'display'
							? `<a href="/${companyId}/permits/edit/${row.Id}">${DataGrid.escapeHtml(data)}</a>`
							: data,
					},
					{ data: 'PermitStatus', render: DataGrid.renderText },
					{ data: 'StartDate', className: 'dt-left text-nowrap', render: renderReportDate },
					{ data: 'EndDate', className: 'dt-left text-nowrap', render: renderReportDate },
					{
						data: 'DurationDays',
						className: 'dt-left text-nowrap',
						render: (data, type) => {
							if (type === 'display') return data == null ? '&mdash;' : `${data} d`;
							return data ?? '';
						},
					},
					{ data: 'Certificates', orderable: false, render: DataGrid.renderText },
					// Used for date grouping and the date filters; shown in the group headers.
					{ data: 'CreatedWhen', visible: false, render: renderReportDate },
				],
			});

			new TomSelect('#ddlGroupBy', {
				plugins: ['remove_button'],
				maxItems: null,
				hideSelected: true,
				controlInput: null,
				onChange: function () { setGroups(this.getValue()); },
			});


			// ── Buttons ──────────────────────────────────────────
			$('.view-report').click(() => {
				$('#kpiSection, #chartsSection').hide();
				$('#reportLoading').show();

				const f = readFilters();

				// Grid (client-side)
				reportFilter = f;
				tbl.draw();

				// Chart data (server-side aggregation)
				var chartParams = { useDateRange: f.useDateRange };
				if (f.useDateRange) {
					if (f.start) chartParams.startDate = f.start.toISOString();
					if (f.end)   chartParams.endDate   = f.end.toISOString();
				} else {
					if (f.month != '') chartParams.month = f.month;
					if (f.year  != '') chartParams.year  = f.year;
				}
				if (f.locationId  != '') chartParams.locationId      = f.locationId;
				if (f.holderId    != '') chartParams.holderId        = f.holderId;
				if (f.certificate != '') chartParams.certificateType = f.certificate;
				if (f.status      != '') chartParams.permitStatus    = f.status;

				loadChartData(chartParams);
			});


			$('.clear-range').click(() => {
				fpRange.clear();
			});


			$('.clear-filter').click(() => {
				fpRange.clear();
				locationTree?.updateValue(null);
				selectedLocationId = '';
				Object.values(filterSelects).forEach(s => s.setValue(''));

				reportFilter = null;
				tbl.search('').draw();

				_overduePermits = [];
				$('#overdueContainer').html('<p class="text-secondary text-center py-4 mb-0 small">Apply a filter and click <strong>View report</strong> to see overdue permits.</p>');
				$('#badgeOverdue').addClass('d-none');
				$('#kpiSection, #chartsSection').hide();
			});

			$(document).on('click', '.overdue-page', function (e) {
				e.preventDefault();
				const page = parseInt($(this).data('page'));
				if (!isNaN(page)) renderOverduePage(page);
			});

		});


		// Month/Year and Date range are alternatives: enable the controls of the chosen option.
		const onOptionChange = () => {
			useDateRange = $('#option2').prop('checked');

			['ddlMonth', 'ddlYear'].forEach(id => useDateRange ? filterSelects[id].disable() : filterSelects[id].enable());
			$('#dateRange').prop('disabled', !useDateRange);
		};
	</script>
}