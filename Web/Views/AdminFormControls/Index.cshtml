@using PermitPro.Core.Enums
@model PermitPro.App.ViewModels.FormControlsIndexViewModel

@{
	var isTenant = ViewContext.RouteData.Values["company"] != null;
	Layout = isTenant ? "_Layout" : "_LayoutAdmin";
	ViewData["Title"] = "Form Controls";
	var controlTypes = Enum.GetValues<FormControlTypeEnum>();
	// Base URL for form actions: tenant uses /{company}/formcontrols, admin uses /admin/formcontrols?companyId=
	var baseUrl = isTenant ? $"/{Model.CompanyId}/formcontrols" : $"/admin/formcontrols";
	var resetUrl = isTenant ? $"/{Model.CompanyId}/formcontrols" : $"/admin/formcontrols?companyId={Model.CompanyId}";
	// companyId hidden field is only needed for admin routes
}

<div class="page-header d-flex align-items-center flex-row justify-content-between mb-3">
	<h6 class="mb-0"><i class="fa-solid fa-sliders me-2 text-primary"></i> Form Controls</h6>
	<button type="button" class="btn btn-primary btn-sm" onclick="openCreateDialog()">
		<i class="fa-solid fa-plus me-1"></i> New Control
	</button>
</div>

@* ── Filter bar ──────────────────────────────────────────────────────────── *@
<div class="card shadow-sm border-0 mb-3">
	<div class="card-body py-2">
		<form method="get" class="row g-2 align-items-end">
			@if (!isTenant) { <input type="hidden" name="companyId" value="@Model.CompanyId" /> }
			<div class="col-auto flex-grow-1">
				<input type="text" name="search" value="@Model.Search" class="form-control form-control-sm"
						 placeholder="Search name or label…" />
			</div>
			<div class="col-auto">
				<select name="type" class="form-select form-select-sm" style="min-width:160px;">
					<option value="">All types</option>
					@foreach (var t in controlTypes)
					{
						<option value="@((int)t)" selected="@(Model.TypeFilter == t)">@t</option>
					}
				</select>
			</div>
			<div class="col-auto">
				<button type="submit" class="btn btn-sm btn-primary">
					<i class="fa-solid fa-magnifying-glass me-1"></i> Filter
				</button>
				<a href="@resetUrl" class="btn btn-sm btn-outline-secondary">Reset</a>
			</div>
		</form>
	</div>
</div>

@* ── Table ───────────────────────────────────────────────────────────────── *@
<div class="card shadow-sm border-0">
	<div class="card-body p-0">
		@if (!Model.Controls.Any())
		{
			<div class="text-center py-5 text-muted">
				<i class="fa-solid fa-sliders fa-2x mb-3 d-block"></i>
				No controls yet. <button type="button" class="btn btn-sm btn-link p-0" onclick="openCreateDialog()">Create the
				first one.</button>
			</div>
		}
		else
		{
			<table class="table table-hover mb-0 align-middle">
				<thead class="table-light">
					<tr>
						<th style="padding-left:1.25rem;">Name</th>
						<th>Label</th>
						<th>Type</th>
						<th class="text-center">Required</th>
						<th class="text-center">Sort</th>
						<th>Created</th>
						<th class="text-end" style="padding-right:1.25rem;">Actions</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var c in Model.Controls)
					{
						<tr>
							<td style="padding-left:1.25rem;">
								<span class="fw-500">@c.Name</span>
							</td>
							<td>@c.Label</td>
							<td>
								<span class="badge @GetTypeBadgeClass(c.ControlType)">@c.ControlType</span>
							</td>
							<td class="text-center">
								@if (c.IsRequired)
								{
									<i class="fa-solid fa-check text-success"></i>
								}
								else
								{
									<span class="text-muted">—</span>
								}
							</td>
							<td class="text-center">
								<span class="badge bg-light text-dark border">@c.SortOrder</span>
							</td>
							<td>
								<small class="text-muted">@c.CreatedWhen.ToString("dd MMM yyyy")</small>
							</td>
							<td class="text-end" style="padding-right:1.25rem;">
								<button type="button" class="btn btn-sm btn-outline-secondary me-1" title="Edit"
										  onclick="openEditDialog('@c.Id')">
									<i class="fa-solid fa-pen-to-square"></i>
								</button>
								<button type="button" class="btn btn-sm btn-outline-danger" title="Delete"
										onclick="confirmDelete('@baseUrl/@c.Id/delete', '@Html.Raw(c.Label.Replace("'", "\\'"))')">
									<i class="fa-solid fa-trash"></i>
								</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
</div>

@* ── Pagination ──────────────────────────────────────────────────────────── *@
@if (Model.TotalPages > 1)
{
	<nav class="mt-3">
		<ul class="pagination pagination-sm justify-content-center mb-0">
			<li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
				<a class="page-link"
					href="?search=@Model.Search&type=@((int?)Model.TypeFilter)&page=@(Model.Page - 1)@(isTenant ? "" : $"&companyId={Model.CompanyId}")">Previous</a>
			</li>
			<li class="page-item disabled">
				<span class="page-link">Page @Model.Page of @Model.TotalPages (@Model.TotalCount total)</span>
			</li>
			<li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
				<a class="page-link"
					href="?search=@Model.Search&type=@((int?)Model.TypeFilter)&page=@(Model.Page + 1)@(isTenant ? "" : $"&companyId={Model.CompanyId}")">Next</a>
			</li>
		</ul>
	</nav>
}

<div class="mt-3 text-muted" style="font-size:.8rem;">
	@Model.TotalCount @(Model.TotalCount == 1 ? "control" : "controls") total
</div>

@* ── Delete confirm modal ─────────────────────────────────────────────────── *@
<div class="modal fade" id="dlgDeleteConfirm" tabindex="-1" aria-labelledby="dlgDeleteConfirmTitle" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header bg-danger text-white">
				<h6 class="modal-title fw-semibold" id="dlgDeleteConfirmTitle">
					<i class="fa-solid fa-triangle-exclamation me-2"></i> Confirm Delete
				</h6>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<p class="mb-0">Are you sure you want to delete <strong id="dlgDeleteItemName"></strong>? This cannot be undone.</p>
			</div>
			<div class="modal-footer bg-light">
				<button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
				<form id="frmDeleteConfirm" method="post" class="d-inline">
					@Html.AntiForgeryToken()
					@if (!isTenant) { <input type="hidden" name="companyId" value="@Model.CompanyId" /> }
					<button type="submit" class="btn btn-sm btn-danger">
						<i class="fa-solid fa-trash me-1"></i> Yes, delete
					</button>
				</form>
			</div>
		</div>
	</div>
</div>

@* ── Error modal ──────────────────────────────────────────────────────────── *@
<div class="modal fade" id="dlgError" tabindex="-1" aria-labelledby="dlgErrorTitle" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header bg-dark text-white">
				<h6 class="modal-title fw-semibold" id="dlgErrorTitle">
					<i class="fa-solid fa-circle-exclamation me-2"></i> Error
				</h6>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<p class="mb-0" id="dlgErrorMessage"></p>
			</div>
			<div class="modal-footer bg-light">
				<button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
			</div>
		</div>
	</div>
</div>

@* ── Create / Edit modal ─────────────────────────────────────────────────── *@
<div class="modal fade" id="dlgControl" tabindex="-1" aria-labelledby="dlgControlTitle" aria-hidden="true">
	<div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
		<div class="modal-content">
			<div class="modal-header bg-dark text-white">
				<h6 class="modal-title fw-semibold" id="dlgControlTitle">New Control</h6>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<form id="frmControl" method="post">
				<div class="modal-body">
					@Html.AntiForgeryToken()
					<input type="hidden" name="companyId" value="@Model.CompanyId" />

					<div class="row g-3">
						<div class="col-md-6">
							<label class="form-label">Internal Name <span class="text-danger">*</span></label>
							<input type="text" id="fcName" name="Name" class="form-control form-control-sm" maxlength="100"
									 placeholder="e.g. work_location" required />
							<div class="form-text">Used as an identifier. No spaces recommended.</div>
						</div>
						<div class="col-md-6">
							<label class="form-label">Label <span class="text-danger">*</span></label>
							<input type="text" id="fcLabel" name="Label" class="form-control form-control-sm" maxlength="200"
									 placeholder="e.g. Work Location" required />
						</div>
						<div class="col-md-6">
							<label class="form-label">Control Type <span class="text-danger">*</span></label>
							<select id="fcType" name="ControlType" class="form-select form-select-sm"
									  onchange="onTypeChange(this.value)" required>
								@foreach (var t in controlTypes)
								{
									<option value="@((int)t)">@t</option>
								}
							</select>
						</div>
						<div class="col-md-3">
							<label class="form-label">Sort Order</label>
							<input type="number" id="fcSortOrder" name="SortOrder" class="form-control form-control-sm"
									 value="0" min="0" max="9999" />
						</div>
						<div class="col-md-3 d-flex align-items-end pb-1">
							<div class="form-check">
								<input class="form-check-input" type="checkbox" id="fcRequired" name="IsRequired"
										 value="true" />
								<label class="form-check-label" for="fcRequired">Required</label>
							</div>
						</div>
						<div class="col-md-6" id="rowPlaceholder">
							<label class="form-label">Placeholder</label>
							<input type="text" id="fcPlaceholder" name="Placeholder" class="form-control form-control-sm"
									 maxlength="200" />
						</div>
						<div class="col-md-6">
							<label class="form-label">Help Text</label>
							<input type="text" id="fcHelpText" name="HelpText" class="form-control form-control-sm"
									 maxlength="500" />
						</div>

						@* ── Options panel (Select / MultiChoice / FileUpload) ──── *@
						<div class="col-12" id="panelOptions" style="display:none;">
							<div id="panelChoiceOptions">
								<label class="form-label">Options <span class="text-danger">*</span></label>
								<div class="form-text mb-2">Add the selectable choices. Value is stored; Label is displayed.
								</div>
								<div id="optionsList" class="mb-2"></div>
								<button type="button" class="btn btn-sm btn-outline-secondary" onclick="addOptionRow()">
									<i class="fa-solid fa-plus me-1"></i> Add Option
								</button>
								<input type="hidden" id="fcOptionsJson" name="OptionsJson" />
							</div>
							<div id="panelFileOptions" style="display:none;">
								<label class="form-label">File Upload Settings</label>
								<div class="row g-2 mt-1">
									<div class="col-md-4">
										<label class="form-label small">Max Files</label>
										<input type="number" id="fuMaxFiles" class="form-control form-control-sm" value="1"
												 min="1" max="20" />
									</div>
									<div class="col-md-8">
										<label class="form-label small">Allowed Types</label>
										<input type="text" id="fuAllowedTypes" class="form-control form-control-sm"
												 placeholder="e.g. image/*,application/pdf" />
										<div class="form-text">Comma-separated MIME types.</div>
									</div>
								</div>
								<input type="hidden" id="fcFileOptionsJson" name="OptionsJson" />
							</div>
						</div>
					</div>
				</div>
				<div class="modal-footer bg-light">
					<button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
					<button type="button" class="btn btn-sm btn-primary" onclick="submitDialog()">
						<i class="fa-solid fa-floppy-disk me-1"></i> Save
					</button>
				</div>
			</form>
		</div>
	</div>
</div>

@section CustomCss {
	<style>
		.option-row {
			display: flex;
			gap: .5rem;
			margin-bottom: .4rem;
			align-items: center;
		}

		.option-row input {
			flex: 1;
		}
	</style>
}

@section Scripts {
	<script>
		// ── Constants ────────────────────────────────────────────────────────────
		const TYPE_SELECT = @((int)FormControlTypeEnum.Select);
		const TYPE_MULTI = @((int)FormControlTypeEnum.MultiChoice);
		const TYPE_FILE = @((int)FormControlTypeEnum.FileUpload);
		const TYPES_WITH_PLACEHOLDER = [@((int)FormControlTypeEnum.TextBox), @((int)FormControlTypeEnum.TextArea)];

		const BASE_URL = '@baseUrl';
		let editId = null;
		let optionRowCount = 0;
		let bsModal = null, bsDeleteModal = null, bsErrorModal = null;

		document.addEventListener('DOMContentLoaded', () => {
			bsModal       = new bootstrap.Modal(document.getElementById('dlgControl'));
			bsDeleteModal = new bootstrap.Modal(document.getElementById('dlgDeleteConfirm'));
			bsErrorModal  = new bootstrap.Modal(document.getElementById('dlgError'));
		});

		// ── Delete confirm ───────────────────────────────────────────────────
		function confirmDelete(actionUrl, itemName) {
			document.getElementById('dlgDeleteItemName').textContent = itemName;
			document.getElementById('frmDeleteConfirm').action = actionUrl;
			bsDeleteModal.show();
		}

		// ── Error modal ──────────────────────────────────────────────────────
		function showError(msg) {
			document.getElementById('dlgErrorMessage').textContent = msg;
			bsErrorModal.show();
		}

		// ── Modal open / close ───────────────────────────────────────────────────
		function openCreateDialog() {
			editId = null;
			document.getElementById('dlgControlTitle').textContent = 'New Control';
			document.getElementById('frmControl').action = BASE_URL;
			resetForm();
			bsModal.show();
		}

		async function openEditDialog(id) {
			editId = id;
			document.getElementById('dlgControlTitle').textContent = 'Edit Control';
			document.getElementById('frmControl').action = `${BASE_URL}/${id}/edit`;
			resetForm();

			try {
				const res = await fetch(`${BASE_URL}/${id}`);
				if (!res.ok) throw new Error('Load failed');
				const data = await res.json();
				populateForm(data);
			} catch {
				showError('Failed to load control data. Please try again.');
				return;
			}
			bsModal.show();
		}

		// ── Form helpers ─────────────────────────────────────────────────────────
		function resetForm() {
			document.getElementById('fcName').value = '';
			document.getElementById('fcLabel').value = '';
			document.getElementById('fcType').value = '0';
			document.getElementById('fcSortOrder').value = '0';
			document.getElementById('fcRequired').checked = false;
			document.getElementById('fcPlaceholder').value = '';
			document.getElementById('fcHelpText').value = '';
			document.getElementById('optionsList').innerHTML = '';
			document.getElementById('fuMaxFiles').value = '1';
			document.getElementById('fuAllowedTypes').value = '';
			optionRowCount = 0;
			onTypeChange('0');
		}

		function populateForm(data) {
			document.getElementById('fcName').value = data.name ?? '';
			document.getElementById('fcLabel').value = data.label ?? '';
			document.getElementById('fcType').value = data.controlType;
			document.getElementById('fcSortOrder').value = data.sortOrder ?? 0;
			document.getElementById('fcRequired').checked = !!data.isRequired;
			document.getElementById('fcPlaceholder').value = data.placeholder ?? '';
			document.getElementById('fcHelpText').value = data.helpText ?? '';

			onTypeChange(String(data.controlType));

			const type = parseInt(data.controlType);
			if ((type === TYPE_SELECT || type === TYPE_MULTI) && data.optionsJson) {
				try {
					const opts = JSON.parse(data.optionsJson);
					opts.forEach(o => addOptionRow(o.value, o.label));
				} catch { }
			}
			if (type === TYPE_FILE && data.optionsJson) {
				try {
					const cfg = JSON.parse(data.optionsJson);
					document.getElementById('fuMaxFiles').value = cfg.maxFiles ?? 1;
					document.getElementById('fuAllowedTypes').value = cfg.allowedTypes ?? '';
				} catch { }
			}
		}

		function onTypeChange(typeVal) {
			const t = parseInt(typeVal);
			const showOpts = (t === TYPE_SELECT || t === TYPE_MULTI || t === TYPE_FILE);
			const showChoices = (t === TYPE_SELECT || t === TYPE_MULTI);
			const showFile = (t === TYPE_FILE);
			const showPlaceholder = TYPES_WITH_PLACEHOLDER.includes(t);

			document.getElementById('panelOptions').style.display = showOpts ? '' : 'none';
			document.getElementById('panelChoiceOptions').style.display = showChoices ? '' : 'none';
			document.getElementById('panelFileOptions').style.display = showFile ? '' : 'none';
			document.getElementById('rowPlaceholder').style.display = showPlaceholder ? '' : 'none';
		}

		// ── Choice options rows ──────────────────────────────────────────────────
		function addOptionRow(val = '', lbl = '') {
			const idx = ++optionRowCount;
			const row = document.createElement('div');
			row.className = 'option-row';
			row.id = `optRow_${idx}`;
			row.innerHTML = `
					<input type="text" class="form-control form-control-sm opt-value"
							 placeholder="Value" value="${escapeAttr(val)}" />
					<input type="text" class="form-control form-control-sm opt-label"
							 placeholder="Label" value="${escapeAttr(lbl)}" />
					<button type="button" class="btn btn-sm btn-outline-danger" onclick="removeOptionRow('optRow_${idx}')">
						 <i class="fa-solid fa-xmark"></i>
					</button>`;
			document.getElementById('optionsList').appendChild(row);
		}

		function removeOptionRow(id) {
			document.getElementById(id)?.remove();
		}

		// ── Build hidden OptionsJson before submit ───────────────────────────────
		function buildOptionsJson() {
			const type = parseInt(document.getElementById('fcType').value);

			if (type === TYPE_SELECT || type === TYPE_MULTI) {
				const rows = document.querySelectorAll('#optionsList .option-row');
				const opts = [];
				rows.forEach(row => {
					const v = row.querySelector('.opt-value').value.trim();
					const l = row.querySelector('.opt-label').value.trim();
					if (v) opts.push({ value: v, label: l || v });
				});
				document.getElementById('fcOptionsJson').value = opts.length ? JSON.stringify(opts) : '';
				// remove the file options hidden input name to avoid duplicate
				document.getElementById('fcFileOptionsJson').name = '';
				document.getElementById('fcOptionsJson').name = 'OptionsJson';
				return true;
			}

			if (type === TYPE_FILE) {
				const maxFiles = parseInt(document.getElementById('fuMaxFiles').value) || 1;
				const allowedTypes = document.getElementById('fuAllowedTypes').value.trim();
				const cfg = { maxFiles };
				if (allowedTypes) cfg.allowedTypes = allowedTypes;
				document.getElementById('fcFileOptionsJson').value = JSON.stringify(cfg);
				document.getElementById('fcOptionsJson').name = '';
				document.getElementById('fcFileOptionsJson').name = 'OptionsJson';
				return true;
			}

			// No options for other types
			document.getElementById('fcOptionsJson').value = '';
			document.getElementById('fcOptionsJson').name = 'OptionsJson';
			document.getElementById('fcFileOptionsJson').name = '';
			return true;
		}

		function submitDialog() {
			const form = document.getElementById('frmControl');
			if (!form.checkValidity()) { form.reportValidity(); return; }
			buildOptionsJson();
			form.submit();
		}

		// ── Util ─────────────────────────────────────────────────────────────────
		function escapeAttr(str) {
			return String(str ?? '').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
		}
	</script>
}

@functions {
	static string GetTypeBadgeClass(FormControlTypeEnum type) => type switch
	{
		FormControlTypeEnum.TextBox => "bg-info-subtle text-info-emphasis border border-info-subtle",
		FormControlTypeEnum.TextArea => "bg-info-subtle text-info-emphasis border border-info-subtle",
		FormControlTypeEnum.Checkbox => "bg-success-subtle text-success-emphasis border border-success-subtle",
		FormControlTypeEnum.MultiChoice => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
		FormControlTypeEnum.Select => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
		FormControlTypeEnum.DateTimeInput => "bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle",
		FormControlTypeEnum.FileUpload => "bg-primary-subtle text-primary-emphasis border border-primary-subtle",
		_ => "bg-light text-dark border",
	};
}
