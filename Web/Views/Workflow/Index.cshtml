@{
	ViewData["Title"] = "Settings / Workflow";
	ViewData["SubTitle"] = "Summary";

	var companyId = ViewContext.RouteData.Values["company"] as string;
}

@model WorkflowViewModel

@* Wraps on phones: the New workflow button first, then the filter. *@
<div class="d-flex flex-wrap align-items-center gap-3">
	<div class="flex-grow-1 d-flex align-items-center gap-2 gap-sm-3 order-2 order-sm-1">
		<label for="ddlFilter" class="text-nowrap">View by</label>
		<div class="grid-filter">
			<select id="ddlFilter" autocomplete="off">
				<option value="" selected>All workflows</option>
				<option value="Active">Active</option>
				<option value="Inactive">Inactive</option>
			</select>
		</div>
	</div>
	<div class="order-1 order-sm-2 ms-auto">
		<a href="#dlgNew" class="btn btn-sm btn-primary no-loading" data-bs-toggle="modal" data-bs-target="#dlgNew">
			<span class="px-2"><i class="fa-sharp fa-solid fa-plus me-2"></i> New workflow</span>
		</a>
	</div>
</div>

<div class="mt-4 card data-grid">
	<div class="card-body">
		<div class="grid-error alert alert-danger d-none" role="alert"></div>
		<table id="tblWorkflows" class="table table-sm table-hover align-middle w-100">
			<thead>
				<tr>
					<th>Workflow Name</th>
					<th>Description</th>
					<th class="text-center">Is Active?</th>
					<th class="text-center">PTW With Certificate?</th>
					<th>Created When</th>
					<th class="text-center">Action</th>
				</tr>
			</thead>
		</table>
	</div>
	@Html.AntiForgeryToken()
</div>

<!-- Modal -->
<div class="modal fade" id="dlgNew" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="dlgNewLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<form id="frmNew" method="post" class="needs-validation" onsubmit="return false" novalidate>
				<div class="modal-header bg-dark text-white">
					<h6 class="modal-title mb-0 w-100" id="dlgNewLabel">New workflow</h6>
					<a href="#" class="no-loading text-secondary" data-bs-dismiss="modal" aria-label="Close"><i class="fa-sharp fa-solid fa-xmark fa-xl"></i></a>
				</div>
				<div class="modal-body">
					<div class="form-group mb-3">
						<label for="workflowName" class="form-label">Name <span class="text-danger">*</span></label>
						<input id="workflowName" type="text" class="form-control" required />
						<div class="ms-2 invalid-feedback">Enter a workflow name</div>
					</div>
					<div class="form-group mb-3">
						<label for="workflowDescription" class="form-label">Description</label>
						<textarea id="workflowDescription" rows="2" class="form-control"></textarea>
					</div>
					<div class="form-check form-switch mb-3">
						<input class="form-check-input" type="checkbox" role="switch" id="workflowActive" />
						<label class="form-check-label" for="workflowActive">Is active?</label>
					</div>
					<div class="form-check form-switch mb-3">
						<input class="form-check-input" type="checkbox" role="switch" id="workflowCertificate" />
						<label class="form-check-label" for="workflowCertificate">For PTW with certificate?</label>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
					<button type="button" class="btn btn-sm btn-primary btn-save"><span class="mx-3">Save changes</span></button>
				</div>
				<input type="hidden" id="companyId" value="@companyId" />
			</form>
		</div>
	</div>
</div>

@section CustomCss {
	<partial name="_DataGridStyles" />
	<link rel="stylesheet" href="~/css/workflow.css" />
}

@section Scripts {
	<partial name="_DataGridScripts" />

	<script>
		var tbl = null;

		const companyId = '@companyId';

		// Column index used by the "View by" filter.
		const COL_ACTIVE = 2;

		$(document).ready(() => {

			tbl = DataGrid.create('#tblWorkflows', `/${companyId}/workflow/grid`, {
				pageLength: 20,
				language: {
					emptyTable: 'No workflows found.',
					zeroRecords: 'No matching workflows found.',
				},
				columns: [
					{
						data: 'Name',
						render: (data, type, row) => type === 'display'
							? `<a href="/${companyId}/workflow/edit/${row.Id}">${DataGrid.escapeHtml(data)}</a>`
							: data,
					},
					{ data: 'Description', render: DataGrid.renderText },
					{ data: 'IsActive', className: 'text-center', render: DataGrid.renderActive },
					{
						data: 'HasCertificates',
						className: 'text-center',
						render: (data, type) => type === 'display'
							? (data ? '<i class="fa-sharp fa-solid fa-circle-check fa-lg text-success" title="Yes"></i>' : '')
							: (data ? 'Yes' : 'No'),
					},
					{ data: 'CreatedWhen', className: 'dt-left text-nowrap', render: DataGrid.renderDate },
					DataGrid.htmlColumn('ActionIcons', { className: 'text-center' }),
				],
			});


			@if (User.IsInRole("Super User"))
			{
				@* Super Users: tick rows, then Delete selected (same delete as the row action). *@
				<text>
				DataGrid.bulkDelete(tbl, {
					url: `/${companyId}/workflow/workflows/bulk-delete`,
					id: (row) => row.Id,
					label: (row) => row.Name,
					one: 'workflow',
					many: 'workflows',
					note: 'A workflow that permits use is skipped (deactivate it instead).',
				});
				</text>
			}

			new TomSelect('#ddlFilter', {
				allowEmptyOption: true,
				// Search box inside the dropdown, so the control keeps its height.
				plugins: ['dropdown_input'],
				onChange: (value) => DataGrid.filterExact(tbl, COL_ACTIVE, value),
			});


			/**
			 * Button event handlers
			 */
			$('.btn-save').click(() => {
				const frm = $('#frmNew')[0];
				$('#frmNew').removeClass('needs-validation').addClass('was-validated');

				if (frm.checkValidity()) {
					const workflowName = $('#workflowName').val();
					const workflowDescription = $('#workflowDescription').val();
					const workflowActive = $('#workflowActive').prop('checked');
					const workflowCertificate = $('#workflowCertificate').prop('checked');
					const companyId = $('#companyId').val();

					var formData = new FormData();
					formData.append('Name', workflowName);
					formData.append('Description', workflowDescription);
					formData.append('IsActive', workflowActive);
					formData.append('HasCertificate', workflowCertificate);
					formData.append('CompanyId', companyId);

					$('.loading').show();

					const xhr = $.ajax({
						method: 'POST',
						url: '/@companyId/workflow/workflows',
						data: formData,
						contentType: false,
						processData: false,
						cache: false,
						headers: { 'RequestVerificationToken': DataGrid.antiForgeryToken() },
					});

					xhr.done((response) => {
						if (!response.hasError) {
							$('#dlgNew').modal('hide');
							document.location.href = `/${companyId}/workflow/edit/${response.workflowId}`;
						}
					});

					xhr.always(() => {
						$('.loading').hide();
					});

				}
			});


			/**
			 * Modal event handlers
			 */
			$('#dlgNew').on('shown.bs.modal', (e) => {
				$('#frmNew').removeClass('was-validated').addClass('needs-validation');
				$('#workflowName').val(null);
				$('#workflowDescription').val(null);
				$('#workflowActive').prop('checked', false);
				$('#workflowCertificate').prop('checked', false);
			});


			$('#btnDeleteItem').click(() => {
				var id = $('#btnDeleteItem').data('itemId');

				$('#dlgConfirmDeleteItem').modal('hide');
				$('.loading').show();

				var xhr = $.ajax({
					method: 'DELETE',
					url: `/${companyId}/workflow/workflows/${id}`,
					headers: { 'RequestVerificationToken': DataGrid.antiForgeryToken() },
				});

				xhr.done((response, status) => {
					if (status == 'success') {
						if (response.success) {
							tbl.ajax.reload(null, false);
						}
					}
				});

				xhr.always(() => {
					$('#dlgConfirmDeleteItem').modal('hide');
					$('.loading').hide();
				});
			});

		});


		// Called by the delete icon in the server-built ActionIcons column.
		const deleteItem = (id) => {
			$('#btnDeleteItem').data('itemId', id);
			$('#dlgConfirmDeleteItem').modal('show');
		};

	</script>
}
