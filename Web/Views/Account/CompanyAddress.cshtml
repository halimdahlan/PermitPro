@{
	Layout = "_LayoutAnon";
	ViewData["Title"] = "Sign In";
}

@model CompanyAddressViewModel

@* The apex (permitpro.app) has no company: the user enters their company's address and goes there to sign in. *@
<div class="login-page">
	<div class="login-card">

		<!-- Logo -->
		<div class="login-logo">
			<div class="logo-icon">
				<i class="fa-solid fa-helmet-safety"></i>
			</div>
			<div class="logo-text">PermitPro</div>
			<div class="logo-sub">Permit-to-Work Management System</div>
		</div>

		<h5 class="login-heading">Sign in to your company</h5>
		<p class="login-sub">Enter your company's PermitPro address</p>

		<form id="companyForm" method="get" action="/account/find">

			@if (!string.IsNullOrEmpty(Model.ErrorMessage))
			{
				<div class="validation-summary-errors mb-3">
					<ul><li>@Model.ErrorMessage</li></ul>
				</div>
			}

			<!-- Company address -->
			<div class="mb-4">
				<label for="subdomain" class="form-label">Company address</label>
				<div class="input-group input-group-icon">
					<span class="input-group-text">
						<i class="fa-solid fa-building"></i>
					</span>
					<input id="subdomain" name="subdomain" value="@Model.Subdomain" class="form-control"
					       placeholder="your-company" maxlength="63" required autofocus
					       autocapitalize="none" autocorrect="off" autocomplete="off" spellcheck="false" />
					<span class="input-group-text host-suffix">@Model.HostSuffix</span>
				</div>
			</div>

			<!-- Submit -->
			<button type="submit" class="btn btn-login w-100">
				<i class="fa-solid fa-arrow-right me-2"></i> Continue
			</button>

		</form>

		<div class="mt-3 text-center" style="font-size:.78rem;">
			<a href="/admin/login" style="color:var(--login-muted);text-decoration:none;">
				Super Admin login
			</a>
		</div>

		<p class="login-footer-note">
			Protected by PermitPro &bull; v1.2
		</p>

	</div>
</div>

@section CustomCss {
	<link rel="stylesheet" href="~/css/login.css" />
}
