@{
	ViewData["Title"] = "Settings / Locations";
	ViewData["SubTitle"] = "Summary";
}

@model SitesViewModel

@{
	// Child locations are listed per parent; the root list uses /sites/grid.
	var gridUrl = string.IsNullOrEmpty(Model.ParentId)
		? $"/{Model.CompanyId}/sites/grid"
		: $"/{Model.CompanyId}/sites/grid/{Model.ParentId}";
}

<div class="data-table">
	<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 mb-sm-5">
		@if (Model.SiteParent != null)
		{
			<nav aria-label="breadcrumb">
				<ol class="breadcrumb mb-0">
					<li class="breadcrumb-item active" aria-current="page">
						You are now in <strong class="text-dark">@Model.SiteParent.Name</strong>
					</li>
				</ol>
			</nav>
			<a href="/@Model.CompanyId/sites/@Model.ParentId/new" class="btn btn-sm btn-primary ms-auto"><span class="mx-3"><i class="fa-sharp fa-solid fa-plus me-2"></i> New location</span></a>
		} else {
			<a href="/@Model.CompanyId/sites/@Guid.Empty/new" class="btn btn-sm btn-primary ms-auto"><span class="mx-3"><i class="fa-sharp fa-solid fa-plus me-2"></i> New location</span></a>
		}
	</div>

	@if (TempData["SuccessMessage"] != null)
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			@TempData["SuccessMessage"]
		</div>
	}

	<div class="my-3 card data-grid">
		<div class="card-body">
			<div class="grid-error alert alert-danger d-none" role="alert"></div>
			<table id="tblSites" class="table table-sm table-hover align-middle w-100">
				<thead>
					<tr>
						<th>Location Name</th>
						<th>Description</th>
						<th>Contact Name</th>
						<th>Contact Email</th>
						<th class="text-center">Num. of Permits</th>
						<th class="text-center">Is Active?</th>
						<th class="text-center">Action</th>
					</tr>
				</thead>
			</table>
		</div>
		@Html.AntiForgeryToken()
	</div>

	@if (Model.SiteParent != null)
	{
		<div class="d-flex flex-row align-items-center justify-content-between mt-5">
			<div>
				@if (Model.SiteParent.ParentId != Guid.Empty)
				{
					<a href="/@Model.CompanyId/sites/@Model.SiteParent.ParentId"><i class="fa-sharp fa-solid fa-chevrons-left me-2"></i> Back to parent site</a>
				}
				else
				{
					<a href="/@Model.CompanyId/sites"><i class="fa-sharp fa-solid fa-chevrons-left me-2"></i> Back to parent site</a>
				}
			</div>
		</div>
	}
</div>

@section CustomCss {
	<partial name="_DataGridStyles" />
	<link rel="stylesheet" href="~/css/sites.css" />
}

@section Scripts {
	<partial name="_DataGridScripts" />

	<script>
		var tbl = null;

		$(document).ready(() => {

			tbl = DataGrid.create('#tblSites', '@gridUrl', {
				pageLength: 20,
				language: {
					emptyTable: 'No locations found.',
					zeroRecords: 'No matching locations found.',
				},
				columns: [
					{
						// Opens the child locations of this location.
						data: 'Name',
						render: (data, type, row) => type === 'display'
							? `<a href="/@Model.CompanyId/sites/${row.Id}">${DataGrid.escapeHtml(data)}</a>`
							: data,
					},
					{ data: 'Description', render: DataGrid.renderText },
					{ data: 'ContactName', render: DataGrid.renderText },
					{ data: 'ContactEmail', render: DataGrid.renderText },
					{
						// Permits at this location, with the total including its sub-locations on a second line
						// ("no sub-location" when it has none, so every row is the same height).
						data: 'PermitCount',
						className: 'text-center',
						render: (data, type, row) => type === 'display'
							? `${data}<div class="text-secondary small text-nowrap">${row.HasSubLocations
								? `${row.PermitCountWithSubLocations} incl. sub-locations`
								: 'no sub-location'}</div>`
							: data,
					},
					{ data: 'IsActive', className: 'text-center', render: DataGrid.renderActive },
					DataGrid.htmlColumn('ActionIcons', { className: 'text-center text-nowrap' }),
				],
			});


			$('#btnDeleteItem').click(() => {
				var id = $('#btnDeleteItem').data('itemId');

				$('#dlgConfirmDeleteItem').modal('hide');
				$('.loading').show();

				var xhr = $.ajax({
					method: 'DELETE',
					url: `/@Model.CompanyId/sites/${id}`,
					headers: { 'RequestVerificationToken': DataGrid.antiForgeryToken() },
				});

				xhr.done((response, status) => {
					if (status == 'success') {
						if (response.data == 'OK') {
							tbl.ajax.reload(null, false);
						}
					}
				});

				xhr.always(() => {
					$('#dlgConfirmDeleteItem').modal('hide');
					$('.loading').hide();
				});
			});

		});


		// Called by the delete icon in the server-built ActionIcons column.
		const deleteItem = (id) => {
			$('#btnDeleteItem').data('itemId', id);
			$('#dlgConfirmDeleteItem').modal('show');
		};

	</script>
}
