<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>PermitPro.$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>PermitPro.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
		<PackageScribanIncludeSource>true</PackageScribanIncludeSource>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
	  <UserSecretsId>d5985dcf-6a4c-4788-b35d-e75e087e391d</UserSecretsId>
  <Version>1.0.0</Version>
  </PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Views\Locations\**" />
	  <Compile Remove="wwwroot\lib\threejs\**" />
	  <Content Remove="Views\Locations\**" />
	  <Content Remove="wwwroot\lib\threejs\**" />
	  <EmbeddedResource Remove="Views\Locations\**" />
	  <EmbeddedResource Remove="wwwroot\lib\threejs\**" />
	  <None Remove="Views\Locations\**" />
	  <None Remove="wwwroot\lib\threejs\**" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="Controllers\LocationsController.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="demo.pdf" />
		<None Remove="hello_world.pdf" />
		<None Remove="permit-html.pdf" />
		<None Remove="permit.pdf" />
		<None Remove="wikipedia.pdf" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0" />
		<PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
		<PackageReference Include="Hangfire.SqlServer" Version="1.8.25" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.12" />
		<PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
		<PackageReference Include="PuppeteerSharp" Version="25.12.0" />
		<PackageReference Include="Scriban.Signed" Version="7.5.0" />
		<PackageReference Include="Telerik.UI.for.AspNet.Core" Version="2025.2.520" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core\Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="wwwroot\attachments\" />
		<Folder Include="wwwroot\img\profile\" />
		<Folder Include="wwwroot\lib\FileSaver\" />
	</ItemGroup>

	<ProjectExtensions>
		<VisualStudio>
			<UserProperties UseCdnSupport="False" />
		</VisualStudio>
	</ProjectExtensions>

</Project>
